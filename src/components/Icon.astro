---
import { iconPaths } from '../lib/icons';
interface Props { name: string; size?: number; }
const { name, size = 24 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={iconPaths[name] ?? iconPaths.spark} /></svg>
