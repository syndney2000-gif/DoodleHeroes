---
/* The Lantern Isles as the home page: one place per game, landmarks that
   appear as the player progresses (lib/world.ts), and a day / dusk / night
   sky from the local clock. Labels are HTML over the SVG so they stay
   readable at phone width. */
import Icon from './Icon.astro';

const places = [
  { id: 'island-sketch', name: 'Sketch Cove', icon: 'grid', tint: 'rose', x: 165, y: 232, href: '/island-sketch/play?p=sun' },
  { id: 'isle-spans', name: 'Span Reef', icon: 'bridge', tint: 'sage', x: 205, y: 405, href: '/isle-spans/play?p=two-coves' },
  { id: 'doodle-guess', name: 'Guess Gallery', icon: 'pencil', tint: 'blue', x: 332, y: 160, href: '/doodle-guess/play' },
  { id: 'margin-merge', name: 'Merge Workshop', icon: 'merge', tint: 'lavender', x: 472, y: 200, href: '/margin-merge/play' },
  { id: 'lighthouse-wiring', name: 'The Lighthouse', icon: 'lighthouse', tint: 'gold', x: 712, y: 150, href: '/lighthouse-wiring/play?p=first-light' },
  { id: 'scribble-siege', name: 'Siege Fort', icon: 'swords', tint: 'peach', x: 612, y: 268, href: '/scribble-siege/play' },
];
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(2)}%`;
---
<div class="iw" data-island-world data-time="day">
  <svg class="iw-map" viewBox="0 0 800 480" role="img" aria-label="Map of the Lantern Isles. Each place on the island is one of the games.">
    <defs>
      <linearGradient id="iw-sea" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" class="iw-sea-top" /><stop offset="1" class="iw-sea-bottom" />
      </linearGradient>
      <radialGradient id="iw-glow"><stop offset="0" stop-color="#FFE38A" stop-opacity=".95" /><stop offset="1" stop-color="#FFE38A" stop-opacity="0" /></radialGradient>
      <linearGradient id="iw-beam-fill" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#FFF1B0" stop-opacity=".85" /><stop offset="1" stop-color="#FFF1B0" stop-opacity="0" /></linearGradient>
    </defs>
    <rect width="800" height="480" fill="url(#iw-sea)" />

    <g class="iw-stars" fill="#FFF6D6">
      <circle cx="60" cy="40" r="1.6" /><circle cx="140" cy="90" r="1.2" /><circle cx="250" cy="30" r="1.8" /><circle cx="390" cy="60" r="1.3" />
      <circle cx="470" cy="24" r="1.6" /><circle cx="560" cy="70" r="1.2" /><circle cx="770" cy="150" r="1.5" /><circle cx="30" cy="160" r="1.3" />
      <circle cx="300" cy="100" r="1" /><circle cx="520" cy="120" r="1.1" />
    </g>
    <g class="iw-sun"><circle cx="745" cy="52" r="26" fill="#F2D583" stroke="#B6934D" stroke-width="2.5" /><path d="M736 50h.01M754 50h.01M738 59q7 6 14 0" stroke="#765B31" stroke-width="3" stroke-linecap="round" fill="none" /></g>
    <g class="iw-moon"><path d="M760 40a24 24 0 1 0 8 30 19 19 0 0 1-8-30Z" fill="#FFF3C4" stroke="#C9B57A" stroke-width="2" /></g>
    <g class="iw-clouds" fill="#FFFEF8" stroke="#B8C9AD" stroke-width="2">
      <path class="iw-cloud" d="M40 70c-12-4-8-20 4-18 1-17 27-18 31-3 17-4 23 22 4 23H43Z" />
      <path class="iw-cloud second" d="M420 52c-9-3-7-15 3-15 1-12 20-13 23-2 13-3 17 16 3 17Z" />
    </g>

    <g class="iw-decor" data-decor="rainbow" fill="none" stroke-width="9" stroke-linecap="round" opacity=".85">
      <path d="M40 262A170 170 0 0 1 380 262" stroke="#E98A6A" /><path d="M49 262A161 161 0 0 1 371 262" stroke="#F2C14E" />
      <path d="M58 262A152 152 0 0 1 362 262" stroke="#7FB685" /><path d="M67 262A143 143 0 0 1 353 262" stroke="#6CB4C4" />
      <path d="M76 262A134 134 0 0 1 344 262" stroke="#B79CD9" />
    </g>

    <g class="iw-waves" stroke="#FFFFFF" stroke-opacity=".55" stroke-width="3" stroke-linecap="round" fill="none">
      <path d="M30 230q12-6 24 0M720 300q12-6 24 0M420 440q12-6 24 0M600 420q12-6 24 0M40 330q12-6 24 0" />
    </g>

    <!-- Span Reef: three islets, joined as Isle Spans maps are solved -->
    <g class="iw-land">
      <ellipse cx="115" cy="425" rx="40" ry="20" fill="#C9D8B0" stroke="#304C3B" stroke-width="3" />
      <ellipse cx="225" cy="448" rx="34" ry="17" fill="#C9D8B0" stroke="#304C3B" stroke-width="3" />
      <ellipse cx="330" cy="430" rx="30" ry="16" fill="#C9D8B0" stroke="#304C3B" stroke-width="3" />
      <g class="iw-bridge" data-on="bridge-1"><path d="M152 432 190 443" /></g>
      <g class="iw-bridge" data-on="bridge-2"><path d="M258 444 300 434" /></g>
      <g class="iw-bridge" data-on="bridge-3"><path d="M330 414 340 372" /></g>
      <circle cx="115" cy="418" r="5" fill="#67866A" /><circle cx="225" cy="442" r="4" fill="#67866A" />

      <!-- The main island -->
      <path d="M70 300C55 225 140 168 235 172 300 118 420 104 485 140 560 100 700 110 738 196 772 262 742 330 660 352 560 386 420 382 320 372 215 376 88 362 70 300Z" fill="#B8C9A0" stroke="#304C3B" stroke-width="4" stroke-linejoin="round" />
      <path d="M86 304C100 342 176 356 248 352 205 336 150 326 118 300Z" fill="#F1DFAE" />
      <path d="M560 196C590 112 700 106 724 196Z" fill="#A3B98A" stroke="#304C3B" stroke-width="3" stroke-linejoin="round" />
      <path class="iw-path" d="M160 290C220 276 262 236 332 222S452 262 480 258 590 296 612 322M480 258C540 230 600 204 646 180" />

      <!-- trees -->
      <g class="iw-trees" fill="#67866A" stroke="#304C3B" stroke-width="2.5" stroke-linejoin="round">
        <g class="iw-tree"><path d="M110 268V246M98 256q12-34 24 0Z" /></g>
        <g class="iw-tree b"><path d="M262 180V158M250 168q12-34 24 0Z" /></g>
        <g class="iw-tree"><path d="M545 300V278M533 288q12-34 24 0Z" /></g>
        <g class="iw-tree b"><path d="M410 350V328M398 338q12-34 24 0Z" /></g>
        <g class="iw-tree"><path d="M700 300V278M688 288q12-34 24 0Z" /></g>
      </g>

      <!-- Sketch Cove: an easel and, later, bunting -->
      <g stroke="#304C3B" stroke-width="2.5" stroke-linecap="round">
        <path d="M150 292 160 252M184 292 174 252M167 252V290" />
        <rect x="146" y="234" width="42" height="30" rx="3" fill="#FFFEF8" />
        <g data-on="easel"><circle cx="160" cy="246" r="5" fill="#F2C14E" stroke="none" /><path d="M150 258q8-6 14 0t14 0" stroke="#6CB4C4" fill="none" /></g>
      </g>
      <g data-on="bunting"><path d="M96 232Q150 252 220 226" stroke="#304C3B" stroke-width="1.6" fill="none" />
        <path d="M108 238l6 12 6-10ZM132 245l6 12 6-11ZM156 247l6 12 6-12ZM180 243l6 12 6-13ZM203 235l6 11 6-13Z" fill="#E98A6A" stroke="#304C3B" stroke-width="1" /></g>

      <!-- Guess Gallery -->
      <g stroke="#304C3B" stroke-width="2.5" stroke-linejoin="round">
        <rect x="300" y="178" width="66" height="44" fill="#F6E7D0" />
        <path d="M294 180 333 154 372 180Z" fill="#6CB4C4" />
        <rect x="326" y="200" width="14" height="22" fill="#B98A5A" />
        <g data-on="frame-1"><rect x="306" y="186" width="14" height="11" fill="#FFFEF8" /><circle cx="313" cy="191" r="2.5" fill="#E98A6A" stroke="none" /></g>
        <g data-on="frame-2"><rect x="346" y="186" width="14" height="11" fill="#FFFEF8" /><path d="M349 194l4-5 4 5" stroke-width="1.6" fill="none" /></g>
        <g data-on="frame-3"><rect x="326" y="164" width="14" height="10" fill="#FFFEF8" stroke-width="2" /></g>
      </g>

      <!-- Merge Workshop, with chimney smoke once it's been used -->
      <g stroke="#304C3B" stroke-width="2.5" stroke-linejoin="round">
        <rect x="482" y="168" width="12" height="22" fill="#D37B5C" />
        <rect x="440" y="196" width="66" height="50" fill="#EADCF2" />
        <path d="M432 198 473 166 514 198Z" fill="#B79CD9" />
        <rect x="465" y="220" width="16" height="26" fill="#B98A5A" />
        <rect class="iw-window" data-window="0" x="447" y="206" width="12" height="12" />
        <rect class="iw-window" data-window="1" x="489" y="206" width="12" height="12" />
      </g>
      <g class="iw-smoke" data-on="smoke" fill="#FFFFFF" stroke="#B8C9AD" stroke-width="1.5">
        <circle cx="488" cy="158" r="6" /><circle cx="494" cy="146" r="8" /><circle cx="502" cy="130" r="10" />
      </g>

      <!-- Cottages, lit by Lighthouse Wiring -->
      <g stroke="#304C3B" stroke-width="2.5" stroke-linejoin="round">
        <g><rect x="250" y="300" width="40" height="32" fill="#FAF0D5" /><path d="M244 302 270 282 296 302Z" fill="#D37B5C" /><rect class="iw-window" data-window="2" x="263" y="310" width="12" height="11" /></g>
        <g><rect x="348" y="290" width="40" height="32" fill="#F2DDB8" /><path d="M342 292 368 272 394 292Z" fill="#A76C51" /><rect class="iw-window" data-window="3" x="361" y="300" width="12" height="11" /></g>
        <g><rect x="500" y="300" width="40" height="32" fill="#FAF0D5" /><path d="M494 302 520 282 546 302Z" fill="#D37B5C" /><rect class="iw-window" data-window="4" x="513" y="310" width="12" height="11" /></g>
      </g>

      <!-- Siege Fort -->
      <g stroke="#304C3B" stroke-width="2.5" stroke-linejoin="round">
        <path d="M592 340V296h8v-8h8v8h8v-8h8v8h8v44Z" fill="#E7D8C5" />
        <rect x="604" y="318" width="12" height="22" rx="6" fill="#8A6A4A" />
        <path d="M624 288V258" />
        <path class="iw-flag" data-on="flag" d="M624 258h22l-6 7 6 7h-22Z" fill="#E98A6A" />
        <path data-on="tent" d="M650 344l18-28 18 28Z" fill="#F2C14E" />
      </g>

      <!-- Decorations bought with lantern light -->
      <g class="iw-decor" data-decor="flowers" stroke="#304C3B" stroke-width="1.2">
        <circle cx="244" cy="338" r="4" fill="#F6A5C0" /><circle cx="252" cy="341" r="4" fill="#F2C14E" /><circle cx="296" cy="338" r="4" fill="#B79CD9" />
        <circle cx="288" cy="341" r="4" fill="#F6A5C0" /><circle cx="342" cy="327" r="4" fill="#F2C14E" /><circle cx="350" cy="330" r="4" fill="#E98A6A" />
        <circle cx="392" cy="327" r="4" fill="#F6A5C0" /><circle cx="496" cy="338" r="4" fill="#B79CD9" /><circle cx="504" cy="341" r="4" fill="#F2C14E" />
        <circle cx="544" cy="338" r="4" fill="#E98A6A" /><circle cx="536" cy="341" r="4" fill="#F6A5C0" />
      </g>
      <g class="iw-decor" data-decor="picnic" stroke="#304C3B" stroke-width="2" stroke-linejoin="round">
        <path d="M120 318l40-7 7 18-40 7Z" fill="#F6A5C0" /><path d="M140 314l7 18M123 327l40-7" stroke="#FFFEF8" stroke-width="3" />
        <rect x="146" y="306" width="14" height="10" rx="2" fill="#C98A4A" /><path d="M148 306q5-7 10 0" fill="none" />
      </g>
      <g class="iw-decor" data-decor="lights">
        <path d="M368 182Q404 208 440 198" fill="none" stroke="#304C3B" stroke-width="1.5" />
        <g class="iw-bulbs" stroke="#304C3B" stroke-width="1"><circle cx="380" cy="192" r="4" fill="#F6A5C0" /><circle cx="394" cy="198" r="4" fill="#F2C14E" />
          <circle cx="408" cy="200" r="4" fill="#7FB685" /><circle cx="422" cy="200" r="4" fill="#6CB4C4" /><circle cx="434" cy="199" r="4" fill="#E98A6A" /></g>
      </g>
      <g class="iw-decor" data-decor="windmill" stroke="#304C3B" stroke-width="2.5" stroke-linejoin="round">
        <path d="M394 186 399 146h12l5 40Z" fill="#F6E7D0" />
        <g class="iw-blades"><path d="M405 146 405 116M405 146 435 146M405 146 405 176M405 146 375 146" stroke-width="5" stroke="#B98A5A" /></g>
        <circle cx="405" cy="146" r="4" fill="#304C3B" />
      </g>

      <!-- The lighthouse -->
      <g stroke="#304C3B" stroke-width="3" stroke-linejoin="round">
        <path d="M630 182 638 92H666L674 182Z" fill="#FFF7DC" />
        <path d="M635 128H669L670 144H634Z" fill="#D37B5C" stroke="none" />
        <rect x="634" y="72" width="36" height="22" fill="#CFE3E6" />
        <path d="M630 74 652 54 674 74Z" fill="#D37B5C" />
        <path d="M646 182V164H658V182" fill="#B98A5A" />
      </g>
    </g>

    <!-- Lights sit above the land so night dims everything except them. -->
    <g class="iw-lights">
      <g class="iw-beam" data-on="beam"><path d="M652 83 800 40V126Z" fill="url(#iw-beam-fill)" /></g>
      <circle class="iw-lamp" cx="652" cy="83" r="8" />
      <circle class="iw-lamp-glow" data-on="lamp" cx="652" cy="83" r="34" fill="url(#iw-glow)" />
      <g class="iw-lanterns">
        <g data-on="lantern-1"><path d="M210 278v-16" /><circle cx="210" cy="258" r="5" /></g>
        <g data-on="lantern-2"><path d="M300 236v-16" /><circle cx="300" cy="216" r="5" /></g>
        <g data-on="lantern-3"><path d="M430 262v-16" /><circle cx="430" cy="242" r="5" /></g>
        <g data-on="lantern-4"><path d="M590 214v-16" /><circle cx="590" cy="194" r="5" /></g>
      </g>
    </g>

    <!-- Sky decorations and this week's event -->
    <g class="iw-decor iw-kite" data-decor="kite" stroke="#304C3B" stroke-width="2">
      <path d="M560 70Q540 140 500 186" fill="none" stroke-width="1.2" />
      <path d="M560 26l16 22-16 22-16-22Z" fill="#E98A6A" /><path d="M560 26v44M544 48h32" stroke-width="1.5" />
      <path d="M552 92l6 4-6 4M544 114l6 4-6 4" fill="#F2C14E" stroke-width="1.2" />
    </g>
    <g class="iw-decor iw-balloon" data-decor="balloon" stroke="#304C3B" stroke-width="2.5" stroke-linejoin="round">
      <path d="M250 40a26 26 0 0 0-26 26c0 16 16 28 20 32h12c4-4 20-16 20-32a26 26 0 0 0-26-26Z" fill="#F2C14E" />
      <path d="M250 40c-8 8-10 40-6 58M250 40c8 8 10 40 6 58" fill="none" stroke-width="2" /><path d="M224 66h52" stroke="#E98A6A" stroke-width="4" />
      <rect x="243" y="104" width="14" height="10" rx="2" fill="#B98A5A" /><path d="M244 98v6m12-6v6" stroke-width="1.5" />
    </g>
    <g class="iw-decor iw-whale" data-decor="whale" stroke="#304C3B" stroke-width="2.5" stroke-linejoin="round">
      <path d="M700 462c0-14 18-20 36-20 20 0 32 10 34 20l10-10v22l-10-6c-6 8-20 12-36 12-20 0-34-6-34-18Z" fill="#7FA9C9" />
      <circle cx="716" cy="456" r="2.2" fill="#304C3B" stroke="none" />
      <path class="iw-spout" d="M732 440c-2-8-8-10-12-8m12 8c2-8 8-10 12-8m-12 8v-10" fill="none" stroke="#FFFFFF" stroke-width="2.5" />
    </g>
    <g class="iw-event" data-event="bloom" fill="#F6A5C0" stroke="#D97A9A" stroke-width="1">
      <ellipse class="iw-petal" cx="80" cy="-10" rx="5" ry="3" /><ellipse class="iw-petal p2" cx="240" cy="-10" rx="5" ry="3" />
      <ellipse class="iw-petal p3" cx="400" cy="-10" rx="5" ry="3" /><ellipse class="iw-petal p4" cx="560" cy="-10" rx="5" ry="3" />
      <ellipse class="iw-petal p5" cx="160" cy="-10" rx="5" ry="3" /><ellipse class="iw-petal p6" cx="480" cy="-10" rx="5" ry="3" />
    </g>
    <g class="iw-event" data-event="kites" stroke="#304C3B" stroke-width="2">
      <g class="iw-kite"><path d="M120 120Q130 170 150 230" fill="none" stroke-width="1.2" /><path d="M120 78l14 20-14 20-14-20Z" fill="#7FB685" /></g>
      <g class="iw-kite b"><path d="M690 230Q680 260 660 290" fill="none" stroke-width="1.2" /><path d="M700 190l12 18-12 18-12-18Z" fill="#B79CD9" /></g>
    </g>
    <g class="iw-event" data-event="starfall" stroke="#FFF6D6" stroke-width="3" stroke-linecap="round">
      <path class="iw-shoot" d="M200 20l-40 24" /><path class="iw-shoot s2" d="M520 30l-40 24" /><path class="iw-shoot s3" d="M700 90l-40 24" />
    </g>
    <g class="iw-event" data-event="lanterns" stroke="#304C3B" stroke-width="1.5">
      <rect class="iw-float" x="420" y="440" width="12" height="16" rx="3" fill="#F2A65A" /><rect class="iw-float f2" x="540" y="460" width="12" height="16" rx="3" fill="#F2C14E" />
      <rect class="iw-float f3" x="640" y="440" width="12" height="16" rx="3" fill="#E98A6A" /><rect class="iw-float f4" x="380" y="470" width="12" height="16" rx="3" fill="#F2A65A" />
    </g>

    <!-- Boats from Margin Merge's finished stories -->
    <g class="iw-boats" stroke="#304C3B" stroke-width="2.5" stroke-linejoin="round">
      <g class="iw-boat" data-on="boat-1"><path d="M440 420h44l-8 12h-28Z" fill="#D37B5C" /><path d="M462 420v-30l16 26Z" fill="#FFFEF8" /></g>
      <g class="iw-boat b" data-on="boat-2"><path d="M560 440h40l-7 11h-26Z" fill="#6CB4C4" /><path d="M580 440v-26l14 22Z" fill="#FFFEF8" /></g>
      <g class="iw-boat" data-on="boat-3"><path d="M690 400h40l-7 11h-26Z" fill="#F2C14E" /><path d="M710 400v-26l14 22Z" fill="#FFFEF8" /></g>
    </g>
  </svg>

  {places.map((p) => (
    <a class={`iw-spot ${p.tint}`} href={p.href} data-place={p.id} aria-label={p.name} style={`left:${pct(p.x, 800)};top:${pct(p.y, 480)}`}>
      <span class="iw-pin"><Icon name={p.icon} size={20} /></span>
      <span class="iw-label"><b>{p.name}</b><small data-place-progress></small></span>
    </a>
  ))}
</div>

<script>
  import { readSnapshot, worldFrom } from '../lib/world';
  import { owned } from '../lib/lantern';
  import { eventFor } from '../lib/events';

  /** Shows what's been built. Runs on load and after a purchase. */
  function paint() {
    const hour = new Date().getHours();
    const time = hour >= 6 && hour < 17 ? 'day' : hour >= 17 && hour < 20 ? 'dusk' : 'night';
    const w = worldFrom(readSnapshot());
    const on = new Set<string>();
    if (w.easel) on.add('easel');
    if (w.bunting) on.add('bunting');
    if (w.lamp) on.add('lamp');
    if (w.beam) on.add('beam');
    if (w.smoke) on.add('smoke');
    if (w.flag) on.add('flag');
    if (w.tent) on.add('tent');
    for (let k = 1; k <= w.bridges; k++) on.add(`bridge-${k}`);
    for (let k = 1; k <= w.frames; k++) on.add(`frame-${k}`);
    for (let k = 1; k <= w.boats; k++) on.add(`boat-${k}`);
    for (let k = 1; k <= w.lanterns; k++) on.add(`lantern-${k}`);
    // Two workshop windows light once it's in use; cottages follow the wiring.
    const lit = new Set<number>(w.smoke ? [0, 1] : []);
    for (let k = 0; k < w.litCottages; k++) lit.add(2 + k);
    const decor = new Set(owned());
    const event = eventFor(new Date()).id;
    const progress: Record<string, string> = {
      'island-sketch': `${w.sketches}/12 sketches`, 'isle-spans': `${w.spans}/12 maps`, 'lighthouse-wiring': `${w.wiring}/12 grids`,
      'doodle-guess': w.frames ? `${w.frames}+ guessed` : 'Daily', 'margin-merge': w.boats ? `${w.boats} of 3 stories` : 'Stories', 'scribble-siege': w.flag ? 'Fort held' : 'Adventure',
    };
    for (const root of document.querySelectorAll<HTMLElement>('[data-island-world]')) {
      root.dataset.time = time;
      root.querySelectorAll<SVGElement>('[data-on]').forEach((el) => el.classList.toggle('on', on.has(el.dataset.on!)));
      root.querySelectorAll<SVGElement>('[data-decor]').forEach((el) => el.classList.toggle('on', decor.has(el.dataset.decor!)));
      root.querySelectorAll<SVGElement>('[data-event]').forEach((el) => el.classList.toggle('on', el.dataset.event === event));
      root.querySelectorAll<SVGElement>('[data-window]').forEach((el) => el.classList.toggle('lit', lit.has(Number(el.dataset.window))));
      root.querySelectorAll<HTMLElement>('[data-place]').forEach((a) => {
        a.querySelector('[data-place-progress]')!.textContent = progress[a.dataset.place!] ?? '';
      });
    }
  }
  paint();
  window.addEventListener('dh:island-change', paint);
</script>

<style>
  .iw { position:relative; border-radius:34px; overflow:hidden; border:3px solid #304C3B; box-shadow:var(--lift-2); background:#BFE0E3; }
  .iw-map { display:block; width:100%; height:auto; }
  .iw-sea-top { stop-color:#CBE7E8; } .iw-sea-bottom { stop-color:#9ACFD3; }
  .iw-stars, .iw-moon { display:none; }
  .iw-path { fill:none; stroke:#FFF6DC; stroke-width:12; stroke-linecap:round; }
  .iw-bridge path { fill:none; stroke:#8A5A3A; stroke-width:7; stroke-linecap:round; }
  .iw-window { fill:#7D8F95; }
  .iw-window.lit { fill:#FFD45C; }
  .iw-lamp { fill:#B9C4C6; stroke:#304C3B; stroke-width:2; }
  .iw-lights:has(.iw-lamp-glow.on) .iw-lamp { fill:#FFD45C; }
  .iw-lanterns path { stroke:#304C3B; stroke-width:2.5; }
  .iw-lanterns circle { fill:#FFD45C; stroke:#304C3B; stroke-width:2; }
  [data-on]:not(.on), [data-decor]:not(.on), [data-event]:not(.on) { display:none; }
