    </g>
    <g class="journey-step" data-step="3">
      <path d="M365 117h104v72H365Z" fill="#F6E8CB" stroke="#8C836C" stroke-width="2" />
      <image href="/images/merge/tools-8.webp" x="385" y="122" width="65" height="59" />
      <path d="m360 114 58-18 56 18" stroke="#8C836C" stroke-width="3" fill="none" />
