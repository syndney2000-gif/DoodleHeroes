      <image href="/images/merge/creatures-5.webp" x="496" y="139" width="37" height="40" />
      <image href="/images/merge/creatures-7.webp" x="560" y="127" width="49" height="52" />
      <path d="m618 173-5-30m0 15-10-6m10-2 8-9" fill="none" stroke="#73936E" stroke-width="3" />
    </g>
    <g font-family="Nunito,system-ui,sans-serif" font-size="9" fill="#526D62" text-anchor="middle"><text x="145" y="220">LANDING</text><text x="300" y="220">CHART ROOM</text><text x="442" y="220">SIGNAL LOFT</text><text x="555" y="220">TIDE POOLS</text></g>
