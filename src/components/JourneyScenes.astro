    <g font-family="Nunito,system-ui,sans-serif" font-size="9" fill="#526D62" text-anchor="middle"><text x="110" y="220">MARKET</text><text x="266" y="220">PAVILION</text><text x="416" y="220">GALLERY</text><text x="555" y="220">HOMECOMING</text></g>
  </svg>
</div>
<style>
  .journey-scenes svg { display:block; width:100%; height:auto; margin:16px 0; }
  .journey-scenes [data-scene] { display:none; }
  .journey-scenes[data-act="1"] [data-scene="1"],.journey-scenes[data-act="2"] [data-scene="2"],.journey-scenes[data-act="3"] [data-scene="3"] { display:block; }
  .journey-step { opacity:.15; filter:grayscale(1); transition:opacity .6s,filter .6s; }
  .journey-scenes:not([data-local-restored="0"]) [data-step="1"],
  .journey-scenes:is([data-local-restored="2"],[data-local-restored="3"],[data-local-restored="4"]) [data-step="2"],
  .journey-scenes:is([data-local-restored="3"],[data-local-restored="4"]) [data-step="3"],
  .journey-scenes[data-local-restored="4"] [data-step="4"] { opacity:1; filter:none; }
</style>
