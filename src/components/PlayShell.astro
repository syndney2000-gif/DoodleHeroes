---
/* The play screen every game shares. Ad-free by design: the page is mostly a
   board and its controls. Pair with setupPlay() from lib/play-ui. */
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import Pip from './Pip.astro';

interface Props {
  game: string;
  description: string;
  section: 'island-sketch' | 'isle-spans' | 'lighthouse-wiring';
  listHref: string;
}

const { game, description, section, listHref } = Astro.props;
---
<Base title={`Play ${game}`} description={description} ads={false} section={section} wide play>
  <header class="pl-head">
    <a class="icon-button pl-back" href={listHref} aria-label={`Back to ${game}`}><Icon name="back" size={20} /></a>
    <div class="pl-titles">
      <p class="eyebrow" id="pl-eyebrow">{game}</p>
      <h1 id="pl-title">{game}</h1>
    </div>
    <button class="icon-button pl-sound" type="button" data-sound-toggle aria-label="Mute sound effects" aria-pressed="true"><Icon name="sound" size={18} /></button>
    <p class="pl-meta">
      <span class="pl-chip pl-chip-time"><Icon name="clock" size={15} /><span id="pl-time">0:00</span></span>
      <span class="pl-chip"><Icon name="bulb" size={15} /><span id="pl-hints">no hints used</span></span>
    </p>
  </header>

  <noscript>
    <p class="note">The puzzle needs JavaScript to run. The <a href={listHref}>rules and guides</a> work without it.</p>
  </noscript>

  <div id="pl-play" hidden>
    <div class="pl-progress" id="pl-progress" role="progressbar" aria-label="Puzzle progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span></span></div>

    <div class="pl-coach" id="pl-coach" hidden>
      <Pip size={64} mood="wave" />
      <div class="pl-coach-bubble" role="status" aria-live="polite">
        <p id="pl-coach-text"></p>
        <div class="pl-coach-actions"><small id="pl-coach-step"></small><button class="btn secondary" type="button" id="pl-coach-next">Got it</button></div>
      </div>
    </div>

    <div class="pl-toolbar" role="toolbar" aria-label="Puzzle tools">
      <slot name="modes" />
      <div class="pl-actions">
        <button class="btn secondary" type="button" id="pl-undo"><Icon name="undo" size={18} /><span class="pl-label">Undo</span></button>
        <button class="btn secondary" type="button" id="pl-hint"><Icon name="bulb" size={18} /><span class="pl-label">Hint</span></button>
        <div class="pl-more-wrap">
          <button class="btn secondary pl-more" type="button" id="pl-more" aria-label="More tools" aria-expanded="false" aria-controls="pl-more-menu"><Icon name="more" size={22} /></button>
          <div class="pl-more-menu" id="pl-more-menu">
            <button class="btn secondary" type="button" id="pl-check"><Icon name="check" size={18} />Check</button>
            <button class="btn secondary" type="button" id="pl-restart"><Icon name="restart" size={18} />Restart</button>
          </div>
        </div>
      </div>
    </div>

    {section === 'island-sketch' && <div class="pl-zoom-tools"><button class="btn secondary" type="button" id="pl-zoom" aria-pressed="false" aria-controls="pl-board">Larger squares</button><small id="pl-zoom-help" hidden>Swipe the clue area to scroll. Tap or drag the squares to draw.</small></div>}
    <div class="pl-board-viewport" tabindex="0" role="region" aria-label={`${game} board, scroll to explore`}><div id="pl-board"></div></div>

    <p class="pl-status" id="pl-status" role="status" aria-live="polite"></p>

    <section class="card pl-done" id="pl-done" hidden>
      <Pip size={84} mood="cheer" class="pl-pip" />
      <p class="pl-report">Saved to your journal</p>
      <h2>A little more light.</h2>
      <span class="pl-grade" id="pl-grade" aria-hidden="true">S</span>
      <p class="pl-stars" id="pl-stars"></p>
      <p id="pl-done-text"></p>
      <p class="pl-best" id="pl-best" hidden></p>
      <p id="pl-note" class="muted"></p>
      <p class="pl-sticker" id="pl-sticker" hidden></p>
      <p class="pl-done-actions">
        <a class="btn" id="pl-next" href={listHref}>Next →</a>
        <button class="btn secondary" type="button" id="pl-again">Try again</button>
        <a class="btn secondary" href={`${listHref}#puzzles`}>All puzzles</a>
        <a class="btn secondary" href="/expedition">Expedition</a>
      </p>
    </section>
  </div>

  <div class="card" id="pl-missing" hidden>
    <h2>That puzzle isn’t on the map</h2>
    <p>The link may be mistyped, or the puzzle may have been renamed. Pick one from the <a href={`${listHref}#puzzles`}>full list</a>.</p>
  </div>

  <section class="pl-help">
    <slot />
  </section>
</Base>

<script>
  const zoom = document.getElementById('pl-zoom');
  zoom?.addEventListener('click', () => {
    const enlarged = document.getElementById('pl-board')!.classList.toggle('enlarged');
    zoom.setAttribute('aria-pressed', String(enlarged));
    zoom.textContent = enlarged ? 'Fit squares to screen' : 'Larger squares';
    document.getElementById('pl-zoom-help')!.hidden = !enlarged;
  });
</script>

<style is:global>
  .pl-head{ display:flex; flex-wrap:wrap; align-items:flex-end; justify-content:space-between; gap:6px 18px; max-width:780px; margin:0 auto; }
  .pl-head h1{ margin:2px 0 6px; }
  .pl-back, .pl-sound{ display:none; }
  body.play-page:has(.pl-head) main.wrap{ max-width:calc(780px + 56px); }
  .pl-meta{ display:flex; gap:8px; margin:0 0 10px; font-variant-numeric:tabular-nums; }
  .pl-chip{ display:inline-flex; align-items:center; gap:6px; padding:5px 12px; border-radius:999px; background:var(--paper); border:2px solid var(--rule); color:var(--ink-soft); font-size:13px; font-weight:800; }

  /* Fills as lines, islands or tiles are completed. */
  .pl-progress{ --p:0; position:relative; max-width:780px; height:10px; margin:4px auto 14px; border-radius:999px; background:var(--soft); overflow:hidden; box-shadow:inset 0 1px 2px rgba(48,76,59,.12); }
  .pl-progress span{ position:absolute; inset:0; transform-origin:left; transform:scaleX(var(--p)); border-radius:inherit;
    background:linear-gradient(90deg, var(--teal), #7FB685 55%, var(--gold)); transition:transform .45s cubic-bezier(.3,1.4,.5,1); }

  .pl-toolbar{ display:flex; flex-wrap:wrap; gap:10px 16px; justify-content:center; margin:6px 0 14px; }
  .pl-modes, .pl-actions{ display:flex; flex-wrap:wrap; gap:8px; }
  .pl-toolbar .btn{ font-size:15px; padding:8px 14px; }
  .pl-toolbar .btn:disabled{ opacity:.45; cursor:default; transform:none; }
  /* Glossy 3D tools, matching Margin Merge. */
  .pl-toolbar .btn.secondary, .pl-zoom-tools .btn{ background:linear-gradient(180deg,#FFFFFF,#F3EAD6); border-color:#D8C7A3; box-shadow:inset 0 -2px 0 #E5D6B6, 0 4px 0 #CDB88E; color:var(--ink); }
  .pl-toolbar .btn:not(.secondary){ background:linear-gradient(180deg,#5CC27A,#2E8A4C); border-color:#26703F; color:#fff; box-shadow:inset 0 2px 0 #ffffff66, 0 4px 0 #1E5A31; text-shadow:0 1px 0 rgba(0,0,0,.2); }
  .pl-toolbar .btn:active{ transform:translateY(3px); }
  .pl-chip{ background:linear-gradient(180deg,#FFFFFF,#F6EFDF); border-color:#E5D8BC; box-shadow:0 2px 0 #E0D1B0; }
  .pl-more-wrap, .pl-more-menu{ display:contents; }
  .pl-more{ display:none; }
  /* Boards that fit don't scroll, so the tray's shadow isn't clipped;
     enlarged 15 × 15 sketches still scroll. */
  .pl-board-viewport{ max-width:100%; overflow:visible; padding:5px 5px 12px; border-radius:12px; }
  .pl-board-viewport:has(.enlarged){ overflow:auto; }
  .pl-zoom-tools{ display:flex; flex-wrap:wrap; gap:10px; align-items:center; justify-content:center; margin-bottom:12px; }
  .pl-zoom-tools .btn{ font-size:12px; }
  .pl-zoom-tools small{ font-size:12px; }
  .pl-status{ text-align:center; min-height:1.65em; margin:14px auto; max-width:620px; }
  #pl-board.celebrate{ animation:pl-cheer .7s cubic-bezier(.3,1.5,.5,1) .15s; }
  @keyframes pl-cheer{ 40%{ transform:scale(1.04) rotate(-.6deg); } 70%{ transform:scale(.99) rotate(.3deg); } }

  .pl-done{ max-width:560px; margin:26px auto; text-align:center; }
  .pl-done.fresh{ animation:pl-rise .55s cubic-bezier(.3,1.4,.5,1) .7s both; }
  @keyframes pl-rise{ from{ opacity:0; transform:translateY(40px) scale(.94); } }
  .pl-done h2{ margin-top:0; }
  .pl-pip{ position:absolute; left:14px; top:-46px; }
  .pl-done.fresh .pl-pip{ animation:pl-rise .5s var(--ease-bounce) .9s both; }
  .pl-sticker{
    display:inline-flex; flex-direction:column; align-items:flex-start; gap:4px; font-family:var(--hand); font-size:19px; padding:8px 16px;
    background:#FFF3B8; border:2px dashed var(--orange); border-radius:var(--wobble-soft); transform:rotate(-1.5deg);
  }
  .pl-done.fresh .pl-sticker{ animation:pl-slap .5s cubic-bezier(.3,1.6,.5,1) 2s both; }
  @keyframes pl-slap{ from{ opacity:0; transform:rotate(-14deg) scale(1.8); } to{ opacity:1; transform:rotate(-1.5deg) scale(1); } }
  .pl-report{ font-family:var(--hand); font-size:18px; color:var(--ink-soft); margin:0; text-transform:uppercase; letter-spacing:.1em; }
  /* A rubber-stamp grade in the corner of the report card. */
  .pl-grade{
    position:absolute; top:14px; right:18px; width:64px; height:64px;
    display:grid; place-items:center; transform:rotate(-12deg);
    font-family:var(--hand); font-size:44px; line-height:1; color:var(--red);
    border:3.5px solid var(--red); border-radius:50%; opacity:.85;
    animation:pl-stamp .35s ease-out;
  }
  .pl-done.fresh .pl-grade{ animation-delay:1.75s; animation-fill-mode:both; }
  @keyframes pl-stamp{ from{ transform:rotate(-12deg) scale(2.2); opacity:0; } to{ transform:rotate(-12deg) scale(1); opacity:.85; } }
  .pl-stars{ font-size:40px; color:var(--orange); letter-spacing:6px; margin:0; }
  .pl-stars span{ display:inline-block; }
  .pl-stars .off{ color:#C9C2A8; }
  /* Stars land one by one after the report card rises. */
  .pl-done.fresh .pl-stars span{ animation:pl-star .5s cubic-bezier(.3,1.7,.5,1) calc(1.05s + var(--k) * .22s) both; }
  @keyframes pl-star{ from{ opacity:0; transform:translateY(-30px) scale(2.2) rotate(-40deg); } }
  .pl-done-actions{ display:flex; gap:10px; justify-content:center; flex-wrap:wrap; margin:12px 0 0; }
  .pl-help{ max-width:780px; margin:40px auto 0; }
  .pl-coach{ display:flex; align-items:flex-end; gap:8px; max-width:560px; margin:0 auto 14px; }
  .pl-coach:not([hidden]){ animation:pl-rise .4s var(--ease-bounce) both; }
  .pl-coach-bubble{ flex:1; padding:10px 14px; background:var(--paper); border:2.5px solid var(--ink); border-radius:18px 18px 18px 6px; box-shadow:var(--lift-1); }
  .pl-coach-bubble p{ margin:0 0 6px; font-size:15px; line-height:1.45; }
  .pl-coach-actions{ display:flex; align-items:center; justify-content:space-between; gap:10px; }
  .pl-coach-actions small{ font-size:12px; font-weight:800; }
  .pl-coach-actions .btn{ min-height:38px; padding:6px 14px; font-size:14px; }
  .pl-best{ display:inline-flex; gap:8px; flex-wrap:wrap; justify-content:center; margin:0 0 8px; }
  .pl-best span{ padding:3px 12px; border-radius:999px; background:var(--paper); border:2px solid var(--rule); font-weight:800; font-size:13px; }
  .pl-best span.gold{ background:#FFF3B8; border-color:var(--gold); }
  #pl-hint.pl-nudge{ animation:pl-nudge 1.2s ease-in-out 3; box-shadow:0 0 0 4px #F2C14E; }
  @keyframes pl-nudge{ 50%{ transform:scale(1.12) rotate(-4deg); } }
  @media (prefers-reduced-motion:reduce){ .pl-grade, .pl-done.fresh, .pl-done.fresh *, #pl-board.celebrate{ animation:none!important; } }

  /* Phones: the tools sit in a thumb bar where the bottom nav would be, and
     the rarely needed ones fold into a menu. */
  @media (max-width:760px){
    /* The site header folds into one compact row so the board gets the room. */
    body.play-page:has(.pl-head) .topbar, body.play-page:has(.pl-head) .play-back{ display:none; }
    body.play-page:has(.pl-head) main.wrap{ padding-top:12px; }
    .pl-head{ display:grid; grid-template-columns:auto minmax(0,1fr) auto; align-items:center; gap:4px 12px; }
    .pl-back, .pl-sound{ display:inline-flex; }
    .pl-titles .eyebrow{ margin:0; font-size:11px; letter-spacing:1.2px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .pl-head h1{ font-size:24px; margin:0; line-height:1.15; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .pl-meta{ grid-column:1 / -1; margin:6px 0 0; }
    .pl-chip{ padding:3px 10px; font-size:12px; }
    .pl-progress{ margin:8px auto 10px; }
    .pl-zoom-tools{ margin-bottom:8px; }
    .pl-zoom-tools .btn{ min-height:36px; padding:4px 14px; }
    .pl-toolbar{
      position:fixed; left:0; right:0; bottom:0; z-index:40; margin:0;
      display:flex; flex-wrap:nowrap; justify-content:space-between; align-items:center; gap:8px;
      padding:10px 12px max(10px, env(safe-area-inset-bottom));
      background:color-mix(in srgb, var(--paper) 92%, transparent); backdrop-filter:blur(8px);
      border-top:2px solid var(--rule); box-shadow:0 -6px 20px rgba(48,76,59,.08);
    }
    .pl-toolbar .pl-modes{ flex-wrap:nowrap; gap:0; padding:3px; border-radius:18px; background:var(--soft); }
    .pl-toolbar .pl-modes .btn{ min-height:46px; box-shadow:none; border-color:transparent; font-size:15px; padding:8px 14px; }
    .pl-toolbar .pl-modes .btn.secondary{ background:transparent; }
    .pl-toolbar .pl-actions{ flex-wrap:nowrap; gap:6px; }
    .pl-actions > .btn, .pl-more{ min-width:48px; min-height:48px; padding:8px; }
    .pl-actions .pl-label{ position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); }
    .pl-more{ display:inline-flex; }
    .pl-more-wrap{ display:block; position:relative; }
    .pl-more-menu{
      display:none; position:absolute; right:0; bottom:calc(100% + 12px); min-width:170px; padding:8px;
      flex-direction:column; gap:6px; background:var(--paper); border:2px solid var(--rule); border-radius:18px;
      box-shadow:0 10px 30px rgba(48,76,59,.18);
    }
    .pl-more-menu.open{ display:flex; animation:pl-menu .18s ease-out; }
    .pl-more-menu .btn{ justify-content:flex-start; box-shadow:none; }
    /* No mode switch (Isle Spans): the actions share the bar, labelled. */
    .pl-toolbar:not(:has(.pl-modes)) .pl-actions{ flex:1; }
    .pl-toolbar:not(:has(.pl-modes)) .pl-actions > .btn{ flex:1; gap:6px; }
    .pl-toolbar:not(:has(.pl-modes)) .pl-label{ position:static; width:auto; height:auto; clip:auto; }
    @keyframes pl-menu{ from{ opacity:0; transform:translateY(8px) scale(.96); } }
  }
</style>
