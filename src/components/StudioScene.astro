---
/* Original code-drawn room scene, using the existing item artwork as props. */
---
<svg class="studio-scene" data-studio-scene data-restored="0" viewBox="0 0 640 235" role="img" aria-label="An abandoned island studio. Four corners are waiting to be restored.">
  <defs><pattern id="studio-floor" width="58" height="13" patternUnits="userSpaceOnUse"><path d="M0 13h58M29 0v13" fill="none" stroke="#D9CDB2" stroke-width=".7" /></pattern></defs>
  <rect width="640" height="235" rx="20" fill="#EDF0E5" />
  <circle cx="571" cy="42" r="24" fill="#EBD18E" />
  <path d="M10 193Q75 167 142 190M485 191Q565 163 630 191" fill="none" stroke="#BDCEA4" stroke-width="3" />
  <path d="M49 58 320 12 591 58" fill="#C5D1B8" stroke="#526C51" stroke-width="2" stroke-linejoin="round" />
  <path d="M65 60h510v142H65z" fill="#FFF9E9" stroke="#849578" stroke-width="2" />
  <path d="M65 170h510v32H65z" fill="#E9DDC3" />
  <path d="M65 170h510v32H65z" fill="url(#studio-floor)" />
  <path d="M65 170h510" stroke="#D9CDB2" />
  <g fill="#DDEBED" stroke="#A9BCA9" stroke-width="1.5"><rect x="112" y="76" width="48" height="45" rx="19" /><rect x="470" y="76" width="48" height="45" rx="19" /><path d="M136 76v45m-24-21h48M494 76v45m-24-21h48" fill="none" /></g>
  <g class="studio-zone" data-room="1">
