</svg>
<style>
  .studio-scene { display:block; width:100%; height:auto; margin:16px 0; }
  .studio-zone { opacity:.13; filter:grayscale(1); transition:opacity .7s,filter .7s; }
  .studio-scene:not([data-restored="0"]) [data-room="1"],
  .studio-scene:is([data-restored="2"],[data-restored="3"],[data-restored="4"]) [data-room="2"],
  .studio-scene:is([data-restored="3"],[data-restored="4"]) [data-room="3"],
  .studio-scene[data-restored="4"] [data-room="4"] { opacity:1; filter:none; }
</style>
