    <path d="M96 158v30m86-30v30m-86-12h86" stroke="#846F52" stroke-width="5" />
    <path d="M178 144v-25l-17-15" stroke="#52734F" stroke-width="3" fill="none" />
    <path d="m149 112 9-13 16 11z" fill="#7E9D71" />
    <image href="/images/merge/heroes-3.webp" x="103" y="112" width="34" height="36" />
    <image href="/images/merge/heroes-2.webp" x="139" y="125" width="26" height="25" />
  </g>
  <g class="studio-zone" data-room="2">
    <rect x="221" y="86" width="85" height="101" rx="4" fill="#C7AD85" stroke="#937D5C" stroke-width="2" />
    <path d="M229 94h69v85h-69z" fill="#E5D6B8" />
    <path d="M226 124h76m-76 30h76" stroke="#937D5C" stroke-width="4" />
    <g stroke="#304C3B" stroke-width=".7"><path d="M234 99h9v23h-9z" fill="#9CAF87" /><path d="M246 101h9v21h-9z" fill="#BC8A83" /><path d="M259 96h10v26h-10z" fill="#D5B869" /><path d="m274 101 9-3 7 24h-10z" fill="#9DBEC0" /></g>
    <image href="/images/merge/paper-6.webp" x="236" y="127" width="49" height="29" />
    <image href="/images/merge/paper-4.webp" x="239" y="157" width="42" height="25" />
  </g>
  <g class="studio-zone" data-room="3">
    <path d="m341 190 20-98 23 98m-32-7h25" stroke="#9F8057" stroke-width="4" fill="none" stroke-linecap="round" />
    <rect x="333" y="102" width="57" height="60" rx="3" fill="#FFFDF2" stroke="#AA926D" stroke-width="2" />
    <path d="M339 148q12-24 22-8t23-10v25h-45z" fill="#B9CBA0" />
    <circle cx="372" cy="117" r="6" fill="#E6CB85" />
    <image href="/images/merge/tools-5.webp" x="389" y="153" width="35" height="35" />
    <image href="/images/merge/tools-4.webp" x="390" y="115" width="26" height="44" />
  </g>
  <g class="studio-zone" data-room="4">
    <ellipse cx="491" cy="184" rx="51" ry="11" fill="#D2BFD0" />
    <path d="M538 181v-37m0 13q-20-5-18-18 18 1 18 18m0-3q18-3 17-16-16 0-17 16" fill="#8CA17D" stroke="#65825F" stroke-width="1.5" />
    <path d="M529 170h19l-3 20h-13z" fill="#C49477" />
