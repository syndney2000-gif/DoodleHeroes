---
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
  /** Load AdSense. Off for play screens: a page that is mostly a game board
      must never carry ads next to its controls. */
  ads?: boolean;
  /** Which top-level section to mark as current in the nav. */
  section?: 'home' | 'games' | 'scribble-siege' | 'doodle-guess' | 'merge' | 'draw-party' | 'expedition'
    | 'island-sketch' | 'isle-spans' | 'lighthouse-wiring' | 'guides' | 'about';
  wide?: boolean;
  noindex?: boolean;
}

const { title, description, ads = true, section, wide = false, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/index$/, '/').replace(/\.html$/, ''), Astro.site);
const fullTitle = title === 'Doodle Heroes' ? title : `${title} · Doodle Heroes`;
const nav = [
  { href: '/', label: 'Home', key: 'home' },
  { href: '/games', label: 'Games', key: 'games' },
  { href: '/expedition', label: 'Expedition', key: 'expedition' },
  { href: '/guides', label: 'Guides', key: 'guides' },
  { href: '/about', label: 'About', key: 'about' },
];
// Every individual game's pages light up "Games" in the menu.
const gameSections = ['scribble-siege', 'doodle-guess', 'merge', 'draw-party', 'island-sketch', 'isle-spans', 'lighthouse-wiring'];
const navKey = section && gameSections.includes(section) ? 'games' : section;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical.href}>
  {noindex && <meta name="robots" content="noindex">}
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonical.href}>
  <meta name="theme-color" content="#FBF7EC">
  <link rel="icon" type="image/png" sizes="64x64" href="/icons/favicon-64.png">
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@500;700;800&family=Patrick+Hand&display=swap" rel="stylesheet">
  {ads && (
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2838226413097378" crossorigin="anonymous"></script>
  )}
  <slot name="head" />
</head>
<body>
  <a class="sr-only" href="#main">Skip to content</a>
  <header class="topbar">
    <div class={wide ? 'wrap wide' : 'wrap'}>
      <a class="brand" href="/">Doodle <span>Heroes</span></a>
      <nav aria-label="Main">
        {nav.map((item) => (
          <a href={item.href} aria-current={navKey === item.key ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
    </div>
  </header>
  <main id="main" class={wide ? 'wrap wide' : 'wrap'}>
    <slot />
  </main>
  <footer class="site">
    <div class={wide ? 'wrap wide' : 'wrap'}>
      <nav aria-label="Site">
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
        <a href="/progress">Your progress</a>
      </nav>
      <p>Doodle Heroes is a small collection of hand-made logic puzzles. Every puzzle can be solved by reasoning alone — no guessing.</p>
    </div>
  </footer>
  <script>
    /* The old drawing-game site installed a service worker. The current
       /sw.js removes itself; registering it here makes sure visitors whose
       browser still runs the old one pick that up promptly. */
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.getRegistrations().then((regs) => {
        for (const reg of regs) reg.update().catch(() => {});
      });
    }
  </script>
</body>
</html>
