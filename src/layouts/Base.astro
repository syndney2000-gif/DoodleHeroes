---
import '../styles/site.css';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  description: string;
  /** Load AdSense. Off for play screens: a page that is mostly a game board
      must never carry ads next to its controls. */
  ads?: boolean;
  /** Which top-level section to mark as current in the nav. */
  section?: 'home' | 'games' | 'scribble-siege' | 'doodle-guess' | 'merge' | 'expedition'
    | 'island-sketch' | 'isle-spans' | 'lighthouse-wiring' | 'guides' | 'notes' | 'about' | 'journal' | 'settings';
  wide?: boolean;
  noindex?: boolean;
  /** A play screen: on phones the board's own toolbar replaces the bottom nav. */
  play?: boolean;
}

const { title, description, ads = true, section, wide = false, noindex = false, play = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/index$/, '/').replace(/\.html$/, ''), Astro.site);
const fullTitle = title === 'Doodle Heroes' ? title : `${title} · Doodle Heroes`;
const nav = [
  { href: '/', label: 'Home', key: 'home', icon: 'home' },
  { href: '/games', label: 'Games', key: 'games', icon: 'grid' },
  { href: '/progress', label: 'Journal', key: 'journal', icon: 'journal' },
];
// Every individual game's pages light up "Games" in the menu.
const gameSections = ['scribble-siege', 'doodle-guess', 'merge', 'island-sketch', 'isle-spans', 'lighthouse-wiring'];
const navKey = section && gameSections.includes(section) ? 'games' : section;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical.href}>
  {noindex && <meta name="robots" content="noindex">}
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonical.href}>
  <meta name="theme-color" content="#FAF7EF">
  <script is:inline>
    /* Apply the saved theme before first paint so there's no flash. */
    try {
      var theme = JSON.parse(localStorage.getItem('dh:settings:theme') || '"day"');
      if (theme === 'night' || (theme === 'auto' && matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.dataset.theme = 'night';
        document.querySelector('meta[name=theme-color]').content = '#13222A';
      }
      var get = function (k, d) { var v = localStorage.getItem('dh:settings:' + k); return v == null ? d : JSON.parse(v); };
      var html = document.documentElement;
      html.dataset.style = get('play-style', 'explorer');
      html.dataset.text = get('text-size', 'normal');
      if (get('patterns', false)) html.setAttribute('data-patterns', '');
    } catch (e) { /* Storage blocked: stay in daylight. */ }
  </script>
  <link rel="icon" type="image/png" sizes="64x64" href="/icons/favicon-64.png">
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@500;600;700;800;900&display=swap" rel="stylesheet">
  <meta name="google-adsense-account" content="ca-pub-2838226413097378">
  {ads && (
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2838226413097378" crossorigin="anonymous"></script>
  )}
  <slot name="head" />
</head>
<body class={play ? 'play-page' : undefined}>
  <a class="sr-only skip" href="#main">Skip to content</a>
  <header class="topbar">
    <div class={wide ? 'wrap wide' : 'wrap'}>
      <a class="brand" href="/">doodle heroes<span aria-hidden="true"> ✳</span></a>
      <nav aria-label="Main">
        {nav.map((item) => (
          <a href={item.href} aria-current={navKey === item.key ? 'page' : undefined}><Icon name={item.icon} size={17} />{item.label}</a>
        ))}
      </nav>
      <div class="header-tools">
        <button class="icon-button" type="button" data-music-toggle aria-label="Enable music" aria-pressed="false"><Icon name="music" size={18} /></button>
        <button class="icon-button" type="button" data-sound-toggle aria-label="Mute sound effects" aria-pressed="true"><Icon name="sound" size={18} /></button>
        <a class="icon-button" href="/settings" aria-label="Settings" aria-current={section === 'settings' ? 'page' : undefined}><Icon name="settings" size={18} /></a>
      </div>
    </div>
  </header>
  <main id="main" class={wide ? 'wrap wide' : 'wrap'}>
    <slot />
  </main>
  <nav class="bottom-nav" aria-label="Main mobile">
    {nav.map((item) => <a href={item.href} aria-current={navKey === item.key ? 'page' : undefined}><Icon name={item.icon} size={21} />{item.label}</a>)}
  </nav>
  <footer class="site">
    <div class={wide ? 'wrap wide' : 'wrap'}>
      <nav aria-label="Site">
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
        <a href="/guides">Guides</a>
        <a href="/notes">Notes</a>
        <a href="/updates">What’s new</a>
        <a href="/expedition">Expedition</a>
        <a href="/progress">Journal</a>
      </nav>
      <p>Six little worlds. A little wonder, one tile at a time. Free to play, with your progress saved in this browser.</p>
    </div>
  </footer>
  <script>
    import '../lib/site-shell';
    /* The old drawing-game site installed a service worker. The current
       /sw.js removes itself; registering it here makes sure visitors whose
       browser still runs the old one pick that up promptly. */
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.getRegistrations().then((regs) => {
        for (const reg of regs) reg.update().catch(() => {});
      });
    }
  </script>
</body>
</html>
