---
import Base from '../../layouts/Base.astro';
---
<Base
  title="Play Draw Party"
  description="Draw Party: make a private room, share the code with friends, and take turns drawing while everyone else guesses."
  ads={false}
  section="draw-party"
  wide
>
  <p class="eyebrow">Multiplayer</p>
  <h1>Draw Party</h1>
  <noscript><p class="note">Draw Party needs JavaScript.</p></noscript>

  <section class="card dp-lobby" id="dp-lobby" hidden>
    <label class="dp-field">Your name <input id="dp-name" maxlength="16" autocomplete="nickname" placeholder="e.g. Sam"></label>
    <div class="dp-choices">
      <div>
        <h2>Start a room</h2>
        <p class="muted">You’ll get a code to send to your friends.</p>
        <button class="btn" type="button" id="dp-create">Create a room</button>
      </div>
      <div>
        <h2>Join a room</h2>
        <label class="dp-field">Room code <input id="dp-code" maxlength="4" autocapitalize="characters" placeholder="ABCD" class="dp-code-input"></label>
        <button class="btn secondary" type="button" id="dp-join">Join</button>
      </div>
    </div>
    <p class="dp-error" id="dp-lobby-error" role="alert"></p>
  </section>

  <p class="note" id="dp-offline" hidden>Draw Party isn’t switched on yet on this site. Please check back soon — in the meantime, try <a href="/doodle-guess/play">Doodle Guess</a>.</p>

  <section class="dp-room" id="dp-room" hidden>
    <div class="dp-head">
      <p class="dp-code">Room <b id="dp-room-code">ABCD</b></p>
      <button class="btn secondary" type="button" id="dp-invite">Copy invite link</button>
      <span class="dp-timer" id="dp-timer" aria-live="off"></span>
    </div>
    <p class="dp-word" id="dp-word" aria-live="polite"></p>
    <div class="dp-options" id="dp-options" hidden></div>

    <div class="dp-main">
      <div class="dp-stage">
        <canvas id="dp-canvas" width="1000" height="1000" aria-label="Shared drawing"></canvas>
        <div class="dp-tools" id="dp-tools" hidden>
          <span class="dp-swatches" id="dp-swatches"></span>
          <button class="btn secondary" type="button" id="dp-size">Thin</button>
          <button class="btn secondary" type="button" id="dp-clear">Clear</button>
        </div>
      </div>
      <aside class="dp-side">
        <ol class="dp-players" id="dp-players" aria-label="Players"></ol>
        <p><button class="btn" type="button" id="dp-start" hidden>Start the game</button></p>
        <div class="dp-chat" id="dp-chat" role="log" aria-live="polite" aria-label="Chat and guesses"></div>
        <form class="dp-chat-form" id="dp-chat-form" autocomplete="off">
          <label class="sr-only" for="dp-msg">Guess or chat</label>
          <input id="dp-msg" maxlength="80" placeholder="Type your guess…" enterkeyhint="send">
          <button class="btn" type="submit">Send</button>
        </form>
      </aside>
    </div>
  </section>

  <section class="dp-help">
    <h2>How to play</h2>
    <ul>
      <li>One person creates a room and shares the code (or the invite link). Up to 8 can join.</li>
      <li>On your turn, pick one of three words and draw it. Everyone else types guesses in the chat.</li>
      <li>The faster someone guesses, the more points they get — and the artist scores for every right guess.</li>
      <li>Letters of the word appear as hints halfway through, and again near the end.</li>
    </ul>
    <p>More on the <a href="/draw-party">Draw Party page</a>.</p>
  </section>
</Base>

<script>
  import type { PublicState, ServerMsg, Stroke } from '../../games/draw-party/room';
  import { load, save } from '../../lib/storage';

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const local = ['localhost', '127.0.0.1'].includes(location.hostname);
  const SERVER: string = import.meta.env.PUBLIC_PARTY_URL || (local ? 'ws://127.0.0.1:8787' : '');
  const COLOURS = ['#2D2B33', '#E0474C', '#3F7FD8', '#3E9E57', '#F08A24', '#E58FA8', '#FFD84D', '#8A5A3C', '#FFFFFF'];

  let ws: WebSocket | null = null;
  let me = '';
  let state: PublicState | null = null;
  let myWord = '';
  let code = '';

  /* ---------- lobby ---------- */

  const params = new URLSearchParams(location.search);
  $<HTMLInputElement>('dp-name').value = load<string>('draw-party:name') ?? '';
  if (params.get('room')) $<HTMLInputElement>('dp-code').value = params.get('room')!.toUpperCase().slice(0, 4);
  if (!SERVER) $('dp-offline').hidden = false;
  else $('dp-lobby').hidden = false;

  const newCode = () => Array.from({ length: 4 }, () => 'ABCDEFGHJKLMNPQRSTUVWXYZ'[Math.floor(Math.random() * 24)]).join('');
  $('dp-create').addEventListener('click', () => enter(newCode()));
  $('dp-join').addEventListener('click', () => {
    const c = $<HTMLInputElement>('dp-code').value.toUpperCase().replace(/[^A-Z]/g, '');
    if (c.length !== 4) { $('dp-lobby-error').textContent = 'Room codes are four letters.'; return; }
    enter(c);
  });

  function enter(roomCode: string) {
    const name = $<HTMLInputElement>('dp-name').value.trim() || 'Doodler';
    save('draw-party:name', name);
    code = roomCode;
    history.replaceState(null, '', `?room=${code}`);
    $('dp-room-code').textContent = code;
    $('dp-lobby-error').textContent = '';
    connect(name);
  }

  function connect(name: string) {
    ws = new WebSocket(`${SERVER}/room/${code}`);
    ws.onopen = () => ws!.send(JSON.stringify({ t: 'join', name }));
    ws.onmessage = (e) => onMessage(JSON.parse(e.data) as ServerMsg);
    ws.onclose = () => {
      if ($('dp-room').hidden) { $('dp-lobby-error').textContent = 'Couldn’t reach the room. Check your connection and try again.'; return; }
      addChat({ from: '', text: 'Disconnected. Refresh the page to rejoin.', kind: 'system' });
    };
  }
  const send = (m: object) => { if (ws?.readyState === WebSocket.OPEN) ws.send(JSON.stringify(m)); };

  /* ---------- messages from the server ---------- */

  function onMessage(m: ServerMsg) {
    switch (m.t) {
      case 'welcome':
        me = m.you;
        $('dp-lobby').hidden = true;
        $('dp-room').hidden = false;
        clearCanvas();
        m.strokes.forEach(drawStroke);
        setState(m.state);
        break;
      case 'state': setState(m.state); break;
      case 'options': showOptions(m.words); break;
      case 'word': myWord = m.word; renderWord(); break;
      case 'stroke': drawStroke(m.s); break;
      case 'clear': clearCanvas(); break;
      case 'chat': addChat(m); break;
      case 'reveal': myWord = ''; $('dp-word').textContent = `The word was “${m.word}”.`; break;
      case 'error': addChat({ from: '', text: m.message, kind: 'system' }); $('dp-lobby-error').textContent = m.message; break;
    }
  }

  function setState(s: PublicState) {
    const prevPhase = state?.phase;
    state = s;
    if (s.phase !== 'drawing' && s.phase !== 'choosing') myWord = '';
    if (s.phase !== 'choosing') $('dp-options').hidden = true;
    const drawing = s.phase === 'drawing' && s.drawer === me;
    $('dp-tools').hidden = !drawing;
    canvas.classList.toggle('mine', drawing);
    $('dp-start').hidden = !(s.host === me && (s.phase === 'lobby' || s.phase === 'over'));
    $('dp-start').textContent = s.phase === 'over' ? 'Play again' : 'Start the game';
    $('dp-msg').setAttribute('placeholder', s.phase === 'drawing' && s.drawer !== me ? 'Type your guess…' : 'Chat…');
    const list = $('dp-players');
    list.textContent = '';
    for (const p of [...s.players].sort((a, b) => b.score - a.score)) {
      const li = document.createElement('li');
      li.className = [p.id === me ? 'me' : '', p.guessed ? 'guessed' : '', p.id === s.drawer ? 'drawer' : ''].join(' ').trim();
      li.innerHTML = `<span class="nm"></span><span class="tags">${p.id === s.drawer ? '✏️' : ''}${p.guessed ? '✅' : ''}${p.id === s.host ? '👑' : ''}</span><b>${p.score}</b>`;
      li.querySelector('.nm')!.textContent = p.name + (p.id === me ? ' (you)' : '');
      list.append(li);
    }
    if (prevPhase !== s.phase || s.phase === 'drawing') renderWord();
  }

  function renderWord() {
    if (!state) return;
    const el = $('dp-word');
    const drawerName = state.players.find((p) => p.id === state!.drawer)?.name ?? '';
    if (state.phase === 'lobby') el.textContent = state.players.length < 2 ? 'Waiting for friends… share the invite link!' : 'Ready when the host is.';
    else if (state.phase === 'choosing') el.textContent = state.drawer === me ? 'Pick a word to draw:' : `${drawerName} is choosing a word…`;
    else if (state.phase === 'drawing') el.textContent = state.drawer === me ? `Draw: ${myWord}` : state.hint.split('').join(' ');
    else if (state.phase === 'over') el.textContent = 'Game over!';
  }

  function showOptions(words: string[]) {
    const box = $('dp-options');
    box.textContent = '';
    words.forEach((w, i) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'btn';
      b.textContent = w;
      b.addEventListener('click', () => { send({ t: 'choose', i }); box.hidden = true; });
      box.append(b);
    });
    box.hidden = false;
  }

  function addChat(m: { from: string; text: string; kind: string }) {
    const log = $('dp-chat');
    const p = document.createElement('p');
    p.className = `dp-line ${m.kind}`;
    if (m.kind === 'chat') {
      const b = document.createElement('b');
      b.textContent = `${m.from}: `;
      p.append(b, document.createTextNode(m.text));
    } else p.textContent = m.text;
    log.append(p);
    while (log.children.length > 120) log.firstElementChild!.remove();
    log.scrollTop = log.scrollHeight;
  }

  $('dp-chat-form').addEventListener('submit', (e) => {
    e.preventDefault();
    const input = $<HTMLInputElement>('dp-msg');
    if (input.value.trim()) send({ t: 'chat', text: input.value });
    input.value = '';
  });
  $('dp-start').addEventListener('click', () => send({ t: 'start' }));
  $('dp-invite').addEventListener('click', async () => {
    const link = `${location.origin}/draw-party/play?room=${code}`;
    try { await navigator.clipboard.writeText(link); $('dp-invite').textContent = 'Link copied!'; }
    catch { addChat({ from: '', text: `Invite link: ${link}`, kind: 'system' }); }
  });
  setInterval(() => {
    const left = state?.endsAt ? Math.max(0, Math.ceil((state.endsAt - Date.now()) / 1000)) : 0;
    $('dp-timer').textContent = left && (state?.phase === 'drawing' || state?.phase === 'choosing') ? `⏱ ${left}` : '';
  }, 250);

  /* ---------- the canvas ---------- */

  const canvas = $<HTMLCanvasElement>('dp-canvas');
  const ctx = canvas.getContext('2d')!;
  ctx.lineCap = 'round';
  ctx.lineJoin = 'round';
  function clearCanvas() { ctx.clearRect(0, 0, 1000, 1000); }
  function drawStroke(s: Stroke) {
    ctx.strokeStyle = s.c;
    ctx.lineWidth = s.w;
    ctx.beginPath();
    ctx.moveTo(s.p[0], s.p[1]);
    if (s.p.length === 2) ctx.lineTo(s.p[0] + 0.1, s.p[1]);
    for (let k = 2; k < s.p.length; k += 2) ctx.lineTo(s.p[k], s.p[k + 1]);
    ctx.stroke();
  }

  let pen = COLOURS[0];
  let width = 6;
  const sw = $('dp-swatches');
  for (const c of COLOURS) {
    const b = document.createElement('button');
    b.type = 'button';
    b.className = 'dp-swatch';
    b.style.background = c;
    b.setAttribute('aria-label', c === '#FFFFFF' ? 'Eraser (white)' : `Colour ${c}`);
    b.setAttribute('aria-pressed', String(c === pen));
    b.addEventListener('click', () => { pen = c; for (const o of sw.children) o.setAttribute('aria-pressed', String(o === b)); });
    sw.append(b);
  }
  $('dp-size').addEventListener('click', () => { width = width === 6 ? 18 : 6; $('dp-size').textContent = width === 6 ? 'Thin' : 'Thick'; });
  $('dp-clear').addEventListener('click', () => { clearCanvas(); send({ t: 'clear' }); });

  // Live drawing: points are sent in small chunks so friends watch it appear.
  let points: number[] = [];
  let drawingNow = false;
  let flushTimer: number | undefined;
  const pos = (e: PointerEvent) => {
    const r = canvas.getBoundingClientRect();
    return [Math.round(((e.clientX - r.left) / r.width) * 1000), Math.round(((e.clientY - r.top) / r.height) * 1000)];
  };
  const flush = () => {
    if (points.length < 2) return;
    const s: Stroke = { c: pen, w: width, p: points };
    send({ t: 'stroke', s });
    points = points.slice(-2); // the next chunk continues from here
  };
  canvas.addEventListener('pointerdown', (e) => {
    if (!(state?.phase === 'drawing' && state.drawer === me)) return;
    canvas.setPointerCapture(e.pointerId);
    drawingNow = true;
    points = pos(e);
    drawStroke({ c: pen, w: width, p: points });
    flushTimer = window.setInterval(flush, 80);
  });
  canvas.addEventListener('pointermove', (e) => {
    if (!drawingNow) return;
    const [x, y] = pos(e);
    const lx = points[points.length - 2], ly = points[points.length - 1];
    if (Math.abs(x - lx) + Math.abs(y - ly) < 4) return;
    drawStroke({ c: pen, w: width, p: [lx, ly, x, y] });
    points.push(x, y);
    if (points.length > 300) flush();
  });
  const lift = () => {
    if (!drawingNow) return;
    drawingNow = false;
    clearInterval(flushTimer);
    flush();
    points = [];
  };
  canvas.addEventListener('pointerup', lift);
  canvas.addEventListener('pointercancel', lift);
</script>

<!-- Global: players, chat and word buttons are built by the script. Every
     selector is prefixed dp-. -->
<style is:global>
  .dp-field{ display:flex; flex-direction:column; gap:4px; font-family:var(--hand); font-size:20px; margin-bottom:12px; }
  .dp-field input, .dp-chat-form input{
    font:inherit; font-family:var(--text); font-size:17px; padding:8px 12px; min-height:46px;
    border:2px solid var(--ink); border-radius:var(--wobble-soft); background:var(--paper); color:var(--ink);
  }
  .dp-code-input{ text-transform:uppercase; letter-spacing:.3em; font-weight:800; max-width:160px; }
  .dp-lobby{ max-width:640px; margin:12px auto; }
  .dp-choices{ display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:18px; }
  .dp-choices h2{ margin-top:0; font-size:26px; }
  .dp-error{ color:var(--red); min-height:1.4em; margin:8px 0 0; }
  .dp-head{ display:flex; align-items:center; gap:12px; flex-wrap:wrap; }
  .dp-code{ margin:0; font-family:var(--hand); font-size:24px; }
  .dp-code b{ letter-spacing:.2em; color:var(--red); }
  .dp-head .btn{ font-size:17px; padding:6px 14px; min-height:42px; }
  .dp-timer{ margin-left:auto; font-family:var(--hand); font-size:28px; font-variant-numeric:tabular-nums; }
  .dp-word{ font-family:var(--hand); font-size:clamp(24px, 5vw, 34px); letter-spacing:.06em; text-align:center; min-height:1.4em; margin:10px 0; }
  .dp-options{ display:flex; gap:10px; justify-content:center; flex-wrap:wrap; margin-bottom:10px; }
  .dp-main{ display:grid; grid-template-columns:minmax(0, 1fr) 300px; gap:16px; }
  @media (max-width:760px){ .dp-main{ grid-template-columns:1fr; } }
  .dp-stage canvas{
    display:block; width:100%; height:auto; aspect-ratio:1; touch-action:none; border:2.5px solid var(--ink); border-radius:var(--wobble-soft);
    background:#fff repeating-linear-gradient(to bottom, transparent 0 31px, rgba(47,99,200,.12) 31px 32px);
  }
  .dp-stage canvas.mine{ cursor:crosshair; box-shadow:0 0 0 4px var(--highlight); }
  .dp-tools{ display:flex; gap:8px; flex-wrap:wrap; justify-content:center; margin-top:10px; }
  .dp-tools .btn{ font-size:17px; padding:6px 14px; min-height:44px; }
  .dp-swatches{ display:flex; gap:5px; flex-wrap:wrap; }
  .dp-swatch{ width:38px; height:38px; border-radius:50%; border:2.5px solid var(--ink); cursor:pointer; }
  .dp-swatch[aria-pressed="true"]{ outline:3px solid var(--blue); outline-offset:2px; }
  .dp-players{ list-style:none; padding:0; margin:0 0 10px; display:grid; gap:6px; }
  .dp-players li{
    margin:0; display:flex; align-items:center; gap:8px; padding:6px 10px;
    background:var(--paper); border:2px solid var(--ink); border-radius:var(--wobble-soft);
  }
  .dp-players li .nm{ flex:1; font-family:var(--hand); font-size:19px; }
  .dp-players li.me{ background:#FFF8D9; }
  .dp-players li.guessed{ background:#E6F4E9; }
  .dp-chat{ height:260px; overflow-y:auto; padding:8px 10px; background:#fff; border:2px solid var(--ink); border-radius:var(--wobble-soft); font-size:15px; }
  .dp-line{ margin:0 0 4px; }
  .dp-line.system{ color:var(--ink-soft); font-style:italic; }
  .dp-line.correct{ color:var(--green); font-weight:800; }
  .dp-line.close{ color:var(--orange); font-weight:700; }
  .dp-chat-form{ display:flex; gap:6px; margin-top:8px; }
  .dp-chat-form input{ flex:1; min-width:0; }
  .dp-help{ max-width:780px; margin:34px auto 0; }
</style>
