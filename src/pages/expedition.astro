---
import Base from '../layouts/Base.astro';
import { expedition } from '../content/expedition';
---
<Base
  title="Lantern Isles expedition"
  description="The Lantern Isles expedition links all three Doodle Heroes puzzles into a story: four chapters, each with a picture puzzle, a bridge puzzle and a wiring puzzle, to bring a dark island back to life."
  section="expedition"
>
  <p class="eyebrow">Expedition mode</p>
  <h1>Lantern Isles</h1>
  <p class="lede">A dark island, a blank map and a lighthouse that hasn’t shone in years. Each chapter of the expedition asks for one puzzle from each game. Finish all three to complete the chapter, light up part of the island and open the next.</p>

  <figure class="isle-map" aria-label="Island map showing your expedition progress">
    <svg viewBox="0 0 400 230" role="img" aria-labelledby="map-title">
      <title id="map-title">Map of the island: the cove, village, harbour and lighthouse</title>
      <rect width="400" height="230" rx="16" fill="#DCEFF2" />
      <path d="M60 160 C40 110 80 60 150 52 C210 30 290 40 330 80 C370 120 350 180 290 192 C230 210 120 212 60 160 Z"
        fill="#F6EFD9" stroke="#1F1B2D" stroke-width="3" />
      <path d="M150 52 C175 85 220 90 250 70" fill="none" stroke="#C9C0A8" stroke-width="2" stroke-dasharray="4 5" />
      <g class="landmark" data-landmark="cove" transform="translate(95 150)">
        <circle r="18" /><text y="5" text-anchor="middle">⛵</text>
        <text class="lm-label" y="36" text-anchor="middle">Cove</text>
      </g>
      <g class="landmark" data-landmark="village" transform="translate(185 120)">
        <circle r="18" /><text y="5" text-anchor="middle">🏠</text>
        <text class="lm-label" y="36" text-anchor="middle">Village</text>
      </g>
      <g class="landmark" data-landmark="harbour" transform="translate(280 165)">
        <circle r="18" /><text y="5" text-anchor="middle">⚓</text>
        <text class="lm-label" y="36" text-anchor="middle">Harbour</text>
      </g>
      <g class="landmark" data-landmark="lighthouse" transform="translate(300 80)">
        <circle r="18" /><text y="5" text-anchor="middle">🗼</text>
        <text class="lm-label" y="-26" text-anchor="middle">Lighthouse</text>
      </g>
    </svg>
    <figcaption id="map-progress">Your progress is saved in this browser.</figcaption>
  </figure>

  {expedition.map((chapter) => (
    <section class="card chapter" data-landmark={chapter.landmark}>
      <h2>{chapter.title}</h2>
      <p>{chapter.story}</p>
      <p class="locked-note" hidden>Complete the previous chapter to open this one — or play its puzzles any time from each game’s page.</p>
      <ol class="tasks">
        {chapter.tasks.map((t) => (
          <li data-key={`${t.game}/${t.puzzleId}`}>
            <span class="task-game">{t.gameName}</span>
            <a href={t.href} class="task-link">{t.title}</a>
            <span class="task-goal">{t.goal}</span>
            <span class="task-stars" aria-label="Not done yet">☆☆☆</span>
          </li>
        ))}
      </ol>
    </section>
  ))}

  <h2>How the expedition works</h2>
  <ul>
    <li>Each chapter uses one puzzle from <a href="/island-sketch">Island Sketch</a>, <a href="/isle-spans">Isle Spans</a> and <a href="/lighthouse-wiring">Lighthouse Wiring</a>, chosen so the difficulty rises evenly across all three.</li>
    <li>Solving a puzzle anywhere counts: if you’ve already solved one from its game’s page, it’s already ticked off here.</li>
    <li>Stars are your best result for that puzzle. Hints cost stars but never block progress.</li>
    <li>Everything is stored in your browser. You can review or reset it on the <a href="/progress">progress page</a>.</li>
  </ul>
  <p>New to one of the games? Each has a beginner’s guide: <a href="/guides/nonogram-basics">picture logic</a>, <a href="/guides/bridges-basics">bridges</a> and <a href="/guides/wiring-basics">wiring</a>.</p>
</Base>

<script>
  import { results } from '../lib/storage';
  import { starText } from '../lib/scoring';

  const done = results();
  const chapters = [...document.querySelectorAll<HTMLElement>('.chapter')];
  let open = true; // the first chapter is always open
  let completed = 0;
  for (const ch of chapters) {
    const tasks = [...ch.querySelectorAll<HTMLElement>('.tasks li')];
    let finished = 0;
    for (const t of tasks) {
      const r = done[t.dataset.key!];
      if (!r) continue;
      finished++;
      t.classList.add('done');
      const stars = t.querySelector('.task-stars')!;
      stars.textContent = starText(r.stars);
      stars.setAttribute('aria-label', `Done, ${r.stars} of 3 stars`);
    }
    const complete = finished === tasks.length;
    ch.classList.toggle('complete', complete);
    ch.classList.toggle('locked', !open);
    ch.querySelector<HTMLElement>('.locked-note')!.hidden = open;
    if (complete) {
      completed++;
      document.querySelector(`.landmark[data-landmark="${ch.dataset.landmark}"]`)?.classList.add('lit');
    }
    open = open && complete;
  }
  document.getElementById('map-progress')!.textContent =
    completed === chapters.length ? 'The lighthouse shines again. Expedition complete!'
    : `${completed} of ${chapters.length} chapters complete. Progress is saved in this browser.`;
</script>

<style>
  .isle-map svg{ width:100%; height:auto; display:block; }
  .landmark circle{ fill:#E3DED0; stroke:#1F1B2D; stroke-width:2.5; }
  .landmark text{ font-size:18px; }
  .landmark .lm-label{
    font-size:16px; font-family:'Patrick Hand', cursive; fill:#2D2B33;
    /* A halo so labels stay readable where they cross the coastline. */
    paint-order:stroke; stroke:#FFFBEC; stroke-width:4px; stroke-linejoin:round;
  }
  .landmark:not(.lit) text:not(.lm-label){ opacity:.35; filter:grayscale(1); }
  .landmark.lit circle{ fill:#FFCB47; }
  .chapter h2{ margin-top:0; }
  .chapter.complete{ border-color:var(--green); box-shadow:4px 4px 0 var(--green); }
  .chapter.complete h2::after{ content:" ✓"; color:var(--green); }
  .chapter.locked{ opacity:.7; }
  .tasks{ list-style:none; padding:0; margin:0; display:grid; gap:10px; }
  .tasks li{
    display:grid; grid-template-columns:1fr auto; gap:2px 12px; margin:0;
    padding:10px 12px; border:2px solid var(--rule); border-radius:12px; background:#fff;
  }
  .tasks li.done{ border-color:var(--green); background:#F1FAF3; }
  .task-game{ grid-column:1; font-size:13px; text-transform:uppercase; letter-spacing:.05em; color:var(--ink-soft); }
  .task-link{ grid-column:1; font-weight:600; }
  .task-goal{ grid-column:1; font-size:15px; color:var(--ink-soft); }
  .task-stars{ grid-column:2; grid-row:1 / span 3; align-self:center; color:var(--ink-soft); letter-spacing:2px; }
  .tasks li.done .task-stars{ color:var(--orange); }
</style>
