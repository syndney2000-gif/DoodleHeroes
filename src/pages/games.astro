---
import Base from '../layouts/Base.astro';
import GameCard from '../components/GameCard.astro';
import { games } from '../lib/games';
---
<Base title="Your game collection" description="Six single-player games: Island Sketch, Isle Spans, Lighthouse Wiring, Doodle Guess, Margin Merge and Scribble Siege." section="games" ads={false}>
  <p class="eyebrow">Your little collection</p>
  <h1>Find your kind of play.</h1>
  <p class="lede">Six single-player worlds. A quiet puzzle, a new discovery, or a little adventure. There’s no hurry here.</p>
  <div class="world-grid">{games.map(game => <GameCard game={game} />)}</div>
  <section class="card expedition-link"><div><h2>A story between the puzzles.</h2><p>Follow four chapters through the Lantern Isles, one thoughtful step at a time.</p></div><a class="btn secondary" href="/expedition">Start the expedition →</a></section>
</Base>
