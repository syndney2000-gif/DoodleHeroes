---
import Base from '../layouts/Base.astro';

const games = [
  { href: '/scribble-siege', play: '/scribble-siege/play', name: 'Scribble Siege', kind: 'Action', text: 'Survive ten minutes of scribble monsters while your weapons fight on their own. Unlock heroes, or draw your own.' },
  { href: '/doodle-guess', play: '/doodle-guess/play', name: 'Doodle Guess', kind: 'Daily puzzle', text: 'A doodle draws itself line by line. Name it in as few guesses as you can.' },
  { href: '/margin-merge', play: '/margin-merge/play', name: 'Margin Merge', kind: 'Merge game', text: 'Draw doodles, merge two of a kind into something better, fill orders and discover all 32.' },
  { href: '/island-sketch', play: '/island-sketch/play?p=sun', name: 'Island Sketch', kind: 'Logic puzzle', text: 'Picture logic: fill squares from number clues to reveal a hand-drawn sketch.' },
  { href: '/isle-spans', play: '/isle-spans/play?p=two-coves', name: 'Isle Spans', kind: 'Logic puzzle', text: 'Join every island with bridges that match its number.' },
  { href: '/lighthouse-wiring', play: '/lighthouse-wiring/play?p=first-light', name: 'Lighthouse Wiring', kind: 'Logic puzzle', text: 'Turn the tiles so power reaches every cottage.' },
];
---
<Base title="All games" description="Every game on Doodle Heroes: Scribble Siege, Doodle Guess, and three hand-made logic puzzles." section="games">
  <h1>All games</h1>
  <p class="lede">Everything here is free, needs no account, and saves your progress in your own browser.</p>
  <div class="grid-cards">
    {games.map((g) => (
      <article class="card">
        <p class="eyebrow">{g.kind}</p>
        <h3><a href={g.href}>{g.name}</a></h3>
        <p>{g.text}</p>
        <a class="btn" href={g.play}>Play ▶</a>
      </article>
    ))}
  </div>
  <p>Want them linked by a story? Try the <a href="/expedition">Lantern Isles expedition</a>.</p>
</Base>
