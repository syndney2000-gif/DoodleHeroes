---
import Base from '../layouts/Base.astro';

const groups = [
  {
    game: 'Island Sketch',
    href: '/island-sketch',
    items: [
      { href: '/guides/nonogram-basics', title: 'Picture logic for beginners', text: 'The overlap rule, full lines, finished lines and working from the edges.' },
      { href: '/guides/nonogram-advanced', title: 'Advanced picture logic', text: 'Out-of-reach squares, gaps too small for a block, and working out which block a square belongs to.' },
      { href: '/walkthroughs/the-lighthouse', title: 'Walkthrough: The Lighthouse', text: 'A complete 10 × 10 solve in six stages, every deduction shown on the board.' },
    ],
  },
  {
    game: 'Isle Spans',
    href: '/isle-spans',
    items: [
      { href: '/guides/bridges-basics', title: 'Bridge puzzles for beginners', text: 'Counting capacity, islands one short, small neighbours and bridges that block bridges.' },
      { href: '/guides/bridges-advanced', title: 'Advanced bridge puzzles', text: 'Never cut a group off: pairs of 1s and 2s, closed groups, and the group with one way out.' },
      { href: '/walkthroughs/tide-pools', title: 'Walkthrough: Tide Pools', text: 'A complete 7 × 7 solve in five stages, including the isolation step that unlocks it.' },
    ],
  },
  {
    game: 'Lighthouse Wiring',
    href: '/lighthouse-wiring',
    items: [
      { href: '/guides/wiring-basics', title: 'Wiring puzzles for beginners', text: 'What the board’s edge rules out, and how a settled tile decides its neighbours.' },
      { href: '/guides/wiring-advanced', title: 'Advanced wiring puzzles', text: 'Never close a loop, never seal a section off, and the section with one way out.' },
      { href: '/walkthroughs/chapel-green', title: 'Walkthrough: Chapel Green', text: 'A complete 5 × 5 solve in six stages, with two loop deductions.' },
    ],
  },
  {
    game: 'Scribble Siege',
    href: '/scribble-siege',
    items: [
      { href: '/guides/scribble-siege-survival', title: 'Scribble Siege survival guide', text: 'Moving through crowds, collecting experience, choosing cards, elites and the Big Eraser.' },
      { href: '/scribble-siege#weapons', title: 'Weapons, items and upgrades', text: 'Every weapon level, item, enemy and permanent upgrade, with exact numbers.' },
    ],
  },
];
---
<Base
  title="Puzzle guides and walkthroughs"
  description="Illustrated guides to solving logic puzzles without guessing, complete walkthroughs of real puzzles, and a survival guide for Scribble Siege."
  section="guides"
>
  <h1>Guides &amp; walkthroughs</h1>
  <p class="lede">Every technique here is shown on real board positions. Guides teach one idea at a time; walkthroughs put them together on a full puzzle.</p>

  {groups.map((g) => (
    <section>
      <h2><a href={g.href}>{g.game}</a></h2>
      <div class="grid-cards">
        {g.items.map((item) => (
          <article class="card">
            <h3><a href={item.href}>{item.title}</a></h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>
  ))}
</Base>
