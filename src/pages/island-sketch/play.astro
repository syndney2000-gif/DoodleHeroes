---
import PlayShell from '../../components/PlayShell.astro';
import '../../games/nonogram/board.css';
---
<PlayShell
  game="Island Sketch"
  description="Play Island Sketch, a picture logic puzzle: use the number clues to work out which squares to fill and reveal a hand-drawn island sketch."
  section="island-sketch"
  listHref="/island-sketch"
>
  <div class="pl-modes" role="group" aria-label="What a tap does" slot="modes">
    <button class="btn" type="button" data-mode="fill" aria-pressed="true">■ Fill</button>
    <button class="btn secondary" type="button" data-mode="cross" aria-pressed="false">✕ Cross</button>
  </div>

  <h2>Quick controls</h2>
  <ul>
    <li><strong>Tap or click</strong> a square to fill it. Drag along a row or column to fill several at once.</li>
    <li><strong>Cross</strong> squares you know are empty: switch to ✕ Cross, right-click, or hold <kbd>Shift</kbd> while clicking.</li>
    <li><strong>Keyboard:</strong> arrow keys move, <kbd>Space</kbd> fills, <kbd>X</kbd> crosses, <kbd>Ctrl</kbd>+<kbd>Z</kbd> undoes.</li>
    <li><strong>Check</strong> marks any wrong squares and costs nothing. Each <strong>Hint</strong> costs one star.</li>
  </ul>
  <p>New to picture logic? Read <a href="/island-sketch">the rules with worked examples</a>, then <a href="/guides/nonogram-basics">the beginner’s guide</a>.</p>
</PlayShell>

<script>
  import { NonogramBoard } from '../../games/nonogram/board';
  import { allPuzzles, chapters, findPuzzle } from '../../games/nonogram/puzzles';
  import { dailyPuzzle } from '../../games/nonogram/daily';
  import { localDateKey } from '../../lib/rng';
  import { setupModes, setupPlay, showMissing } from '../../lib/play-ui';

  const id = new URLSearchParams(location.search).get('p') ?? 'sun';
  const isDaily = id === 'daily';
  const puzzle = isDaily ? dailyPuzzle(localDateKey()) : findPuzzle(id);

  if (!puzzle) {
    showMissing();
  } else {
    const chapter = chapters.find((c) => c.puzzles.includes(puzzle));
    const next = isDaily ? undefined : allPuzzles[allPuzzles.indexOf(puzzle) + 1];
    const board = setupPlay({
      eyebrow: isDaily ? 'Island Sketch · daily challenge' : `Island Sketch · ${chapter?.title}`,
      title: puzzle.title,
      note: puzzle.note,
      next: next && { href: `/island-sketch/play?p=${next.id}`, label: 'Next sketch →' },
      listHref: '/island-sketch',
      create: (root, callbacks) => new NonogramBoard(root, puzzle, callbacks),
    });
    setupModes((mode) => board.setMode(mode as 'fill' | 'cross'));
  }
</script>
