<!-- Workshop look: a wooden tray of recessed slots, puffy cream tiles,
     glossy 3D controls. Overrides the base rules above. -->
<style is:global>
  .mm { --wood:#C88E58; --wood-dark:#8E5A30; --slot:#E7CFA6; --tile-hi:#FFFDF4; --tile-lo:#F2E0BC; --tile-edge:#C9A574; }
  .mm-board {
    gap:7px; padding:14px; border:0; border-radius:30px;
    background:
      repeating-linear-gradient(97deg, #FFFFFF0A 0 2px, transparent 2px 22px),
      repeating-linear-gradient(83deg, #00000008 0 1px, transparent 1px 15px),
      linear-gradient(160deg, #D9A26A, var(--wood) 45%, #B57A45);
    box-shadow: inset 0 2px 0 #F1C58F, inset 0 -3px 0 #9A6436, 0 8px 0 var(--wood-dark), 0 18px 30px rgba(94,56,24,.35);
  }
  .mm-cell {
    border:0; border-radius:16px; padding:2px;
    background:linear-gradient(180deg, #DDBF91, var(--slot));
    box-shadow: inset 0 3px 5px rgba(96,58,26,.38), inset 0 -1px 0 #F6E2BD;
    transition:transform .18s var(--ease-bounce), box-shadow .18s;
  }
  .mm-cell[data-chain] {
    border:0; transform:translateY(-3px);
    background:radial-gradient(circle at 32% 24%, var(--tile-hi), var(--tile-lo) 78%);
    box-shadow: inset 0 2px 0 #FFFFFF, inset 0 -3px 0 #E4CB9E, 0 4px 0 var(--tile-edge), 0 7px 10px rgba(96,58,26,.28);
  }
  .mm-cell[data-chain=heroes] { --tile-hi:#FFF8FB; --tile-lo:#F6DCE6; --tile-edge:#D2A2B4; }
  .mm-cell[data-chain=paper] { --tile-hi:#FFFDF2; --tile-lo:#F7E5B4; --tile-edge:#D3B26C; }
  .mm-cell[data-chain=tools] { --tile-hi:#F7FCFF; --tile-lo:#D6EAF3; --tile-edge:#94BCCB; }
  .mm-cell[data-chain=creatures] { --tile-hi:#FAFFF4; --tile-lo:#DDEFCB; --tile-edge:#9EC284; }
  .mm-cell .merge-art { filter:drop-shadow(0 3px 2px rgba(60,35,15,.18)); }
  .mm-cell .tier {
    right:2px; bottom:4px; min-width:20px; height:20px; border-radius:50%; font-size:10px; color:#5A3A0E;
    background:radial-gradient(circle at 35% 30%, #FFF0B8, #F2BE3F 60%, #C98B16); box-shadow:inset 0 -1px 0 rgba(0,0,0,.18), 0 1px 2px rgba(0,0,0,.25);
  }
  .mm-cell.sel { outline:0; transform:translateY(-8px) scale(1.05); box-shadow: inset 0 2px 0 #fff, 0 0 0 3px #F7C23E, 0 10px 0 var(--tile-edge), 0 16px 18px rgba(96,58,26,.32); }
  .mm-cell.match { box-shadow: inset 0 2px 0 #fff, 0 0 0 3px #7CC48A, 0 4px 0 var(--tile-edge), 0 7px 10px rgba(96,58,26,.28); animation:mm-match 1.2s ease-in-out infinite; }
  /* Glow, not movement: tap targets must hold still. */
  @keyframes mm-match { 50% { box-shadow: inset 0 2px 0 #fff, 0 0 0 4px #A8E2B2, 0 4px 0 var(--tile-edge), 0 0 16px #8FD89E; } }
  .mm-cell.match::before { content:''; }
  .mm-cell.drop-target { outline:0; background:radial-gradient(circle, #F1FFE8, #CDEDBA); box-shadow: inset 0 0 0 3px #5DAA6E, 0 0 18px #9BE0A6; }
  .mm-cell.pop::after { border-color:#F7C23E; border-width:3px; }
  .mm-ghost { filter:drop-shadow(0 14px 10px rgba(60,35,15,.35)); }

  /* Level gem, XP bar and resource pills. */
  .mm-level { width:46px; height:46px; border-radius:50%; font:700 20px var(--hand); color:#fff; text-shadow:0 1px 0 rgba(0,0,0,.25);
    background:radial-gradient(circle at 35% 28%, #9BE3A4, #3E9B57 58%, #24683A); box-shadow:inset 0 -3px 0 rgba(0,0,0,.2), 0 3px 0 #1E5530, 0 0 0 3px #fff; }
  .mm-xp { height:14px; border-radius:999px; background:#E9DFC9; box-shadow:inset 0 2px 3px rgba(96,58,26,.25); }
  .mm-xp i { border-radius:999px; background:linear-gradient(180deg, #A6EBB1, #4FB06A); box-shadow:inset 0 2px 0 #ffffff80; }
  .mm-pill { border:0; border-radius:999px; padding:6px 12px; font-weight:900; background:linear-gradient(180deg, #FFFFFF, #F4EBD8); box-shadow:inset 0 -2px 0 #E2D2B2, 0 3px 0 #D9C6A0; }
  .resource-drop, .resource-coin { display:inline-block; width:16px; height:16px; font-size:0; flex:none; }
