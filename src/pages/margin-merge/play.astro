---
import Base from '../../layouts/Base.astro';
import JourneyScenes from '../../components/JourneyScenes.astro';
import { studioChapters } from '../../games/merge/studio';
import '../../games/merge/studio.css';
---
<Base
  title="Play Margin Merge"
  description="Play twelve chapters of island stories. Merge discoveries, help your neighbours, earn useful tools and prepare a festival."
  ads={false}
  section="merge"
  wide
>
  <p class="eyebrow">Your little workshop</p>
  <h1>Margin Merge</h1>
  <p class="lede">From a quiet studio to a harbour full of lights. Twelve chapters, four neighbours, and an island to bring together.</p>
  <noscript><p class="note">Margin Merge needs JavaScript. The <a href="/margin-merge">guide</a> works without it.</p></noscript>

  <div class="mm" id="mm" hidden>
    <section class="studio-card" id="mm-studio" aria-labelledby="studio-title">
      <div class="studio-top"><p class="eyebrow" data-story-act>Story 1 of 3 · A place to begin</p><small data-studio-count>0 of {studioChapters.length} projects complete</small></div>
      <h2 id="studio-title" data-studio-title tabindex="-1">Prepare the workshop</h2>
      <p class="studio-story" data-studio-story></p>
      <blockquote class="story-letter" data-story-letter><p data-story-letter-text></p><cite data-story-speaker></cite></blockquote>
      <progress class="studio-progress" data-studio-progress max="48" value="0" aria-label="Overall island story progress"></progress>
      <details class="studio-visual" data-studio-visual open><summary data-scene-caption>Island studio</summary><JourneyScenes /></details>
      <ol class="studio-chapters" data-studio-chapters aria-label="Restoration chapters"></ol>
      <ul class="studio-goals" data-studio-goals aria-label="Current chapter goals"></ul>
      <p class="studio-supply-note" data-studio-supply-note>Discoveries count automatically. Supplying an item removes it from your board.</p>
      <button class="btn studio-restore" type="button" data-studio-restore disabled>Restore the workshop →</button>
      <p class="studio-reward" data-studio-reward></p>
      <div class="studio-ending" data-studio-ending hidden><p class="eyebrow">Story complete</p><h3 data-ending-title>The studio is home again.</h3><p data-ending-text></p><section class="next-story" data-next-story><p data-next-story-text></p><button class="btn" type="button" data-story-continue>Read Mara’s letter →</button></section><button class="btn secondary" type="button" data-studio-continue>Stay in free play</button><a href="/progress">See your achievements in the Journal</a></div>
      <p class="studio-free-play" data-studio-free-play hidden></p>
      <button class="btn" type="button" data-story-resume hidden>Start the next story →</button>
      <p class="story-perks" data-perks-summary></p>
      <details class="story-journal"><summary>Letters &amp; memories</summary><div data-story-archive></div></details>
      <p class="studio-status" data-studio-status role="status" aria-live="polite"></p>
      <a class="studio-board-link" href="#mm-board">Back to merging ↓</a>
    </section>
    <div class="mm-bar">
      <span class="mm-level" id="mm-level" title="Level">1</span>
      <div class="mm-xp"><i id="mm-xp"></i></div>
      <span class="mm-pill" title="Ink"><span class="resource-drop" aria-hidden="true">◈</span> <b id="mm-ink">30</b><small id="mm-ink-next"></small></span>
      <span class="mm-pill" title="Coins"><span class="resource-coin" aria-hidden="true">●</span> <b id="mm-coins">0</b></span>
    </div>

    <section class="mm-tools" aria-label="Earned workshop tools">
      <label for="mm-focus">Sketchbook focus <select id="mm-focus" disabled><option value="">All unlocked chains</option></select></label>
      <p class="muted" id="mm-tools-help">Complete harbour projects to unlock focused drawing and a satchel.</p>
      <details id="mm-satchel-panel"><summary id="mm-satchel-title">Satchel · unlocks in chapter 6</summary><div class="mm-satchel" id="mm-satchel"></div><p class="muted">Select a board item and choose Store selected. Retrieve puts it in the first empty square.</p></details>
    </section>
    <p class="mm-orders-label">Optional orders <a href="#mm-studio">Studio goals ↑</a></p>
    <section class="mm-orders" id="mm-orders" aria-label="Optional orders"></section>

    <div class="mm-board" id="mm-board" role="grid" aria-label="Merge board"></div>

    <div class="mm-actions">
      <button class="btn mm-draw" type="button" id="mm-draw">＋ Draw an item <small>· 1 ink</small></button>
      <button class="btn secondary" type="button" id="mm-erase" disabled>Erase</button>
      <button class="btn secondary" type="button" id="mm-buy">＋ 10 ink · 25 coins</button>
      <button class="btn secondary" type="button" id="mm-store" disabled>Store selected</button>
      <button class="btn secondary" type="button" id="mm-book">Collection book</button>
    </div>
    <p class="mm-status" id="mm-status" role="status" aria-live="polite">Tap the sketchbook to draw your first doodle.</p>

    <dialog class="card mm-dialog" id="mm-collection">
      <h2>Collection</h2>
      <div id="mm-collection-body"></div>
      <form method="dialog"><button class="btn">Close</button></form>
    </dialog>
  </div>

  <section class="mm-help">
    <h2>Quick controls</h2>
    <ul>
      <li><strong>Draw</strong> puts a new doodle on the board for one drop of ink. Ink refills over time.</li>
      <li><strong>Drag</strong> a doodle onto a matching one to merge them — or tap one, then tap where it should go.</li>
      <li>Fill <strong>orders</strong> for coins and experience. Levelling up unlocks new chains.</li>
      <li>Follow your <strong>story goals</strong> and supply the requested items. Each four-chapter story has an ending; choose when to start the next one. Later chapters unlock focused drawing, a satchel, and faster ink.</li>
      <li>Board full? Select a doodle and <strong>Erase</strong> it for a few coins.</li>
    </ul>
    <p>More tips in the <a href="/margin-merge">Margin Merge guide</a>.</p>
  </section>
</Base>

<script>
  import { BOARD_H, BOARD_W, TOP_TIER, chainIds, chains, xpToNext } from '../../games/merge/data';
  import {
    INK_POT, SKIP_ORDER_COST, buyInk, deliver, draw, erase, inkMax, move, newState, nextInkIn, orderCells,
    refillInk, skipOrder, unlockedChains, type MergeState,
  } from '../../games/merge/engine';
  import { load, save } from '../../lib/storage';
  import { playSound } from '../../lib/audio';
  import { reducedMotion } from '../../lib/site-shell';
  import { itemMarkup } from '../../games/merge/art';
  import { mergePerks, storeItem, retrieveItem } from '../../games/merge/perks';
  import { setupStudio } from '../../games/merge/studio-ui';

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const SAVE = 'margin-merge:state';
  const s: MergeState = load<MergeState>(SAVE) ?? newState((Math.random() * 2 ** 32) >>> 0, Date.now());
  refillInk(s, Date.now());
  let selected: number | null = null;
  const persist = () => save(SAVE, s);
  const status = (m: string) => { $('mm-status').textContent = m; };
  const itemName = (c: { chain: keyof typeof chains; tier: number }) => chains[c.chain].items[c.tier - 1].name;
  $('mm').hidden = false;
  const studio = setupStudio($('mm-studio'), s, () => { selected = null; persist(); render(); });

  /* ---------- board ---------- */

  const board = $('mm-board');
  board.style.setProperty('--w', String(BOARD_W));
  const cellEls: HTMLButtonElement[] = [];
  for (let i = 0; i < BOARD_W * BOARD_H; i++) {
    const b = document.createElement('button');
    b.type = 'button';
    b.className = 'mm-cell';
    b.dataset.i = String(i);
    b.setAttribute('role', 'gridcell');
    cellEls.push(b);
    board.append(b);
  }

  function paintBoard(flash?: number) {
    s.cells.forEach((c, i) => {
      const b = cellEls[i];
      b.classList.toggle('sel', selected === i);
      b.classList.remove('pop');
      if (flash === i) { void b.offsetWidth; b.classList.add('pop'); }
      b.setAttribute('aria-selected', String(selected === i));
      const picked = selected == null ? null : s.cells[selected];
      b.classList.toggle('match', !!c && !!picked && i !== selected && c.chain === picked.chain && c.tier === picked.tier && c.tier < TOP_TIER);
      if (!c) {
        b.innerHTML = '';
        delete b.dataset.chain;
        b.setAttribute('aria-label', `Empty square ${i + 1}`);
        return;
      }
      const ch = chains[c.chain];
      b.innerHTML = `${itemMarkup(c)}<span class="tier" aria-hidden="true">${c.tier}</span>`;
      b.dataset.chain = c.chain;
      b.setAttribute('aria-label', `${ch.items[c.tier - 1].name}, ${ch.name} level ${c.tier}`);
    });
    $<HTMLButtonElement>('mm-erase').disabled = selected == null || !s.cells[selected];
    $<HTMLButtonElement>('mm-store').disabled = selected == null || !s.cells[selected] || (s.satchel?.length ?? 0) >= mergePerks(s).satchel;
  }

  // Motion is presentation only: rules and saves commit before effects run.
  const animations = new Map<number, Animation>();
  function animateMove(from: number, to: number, swapped: boolean) {
    if (reducedMotion()) return;
    const a = cellEls[from].getBoundingClientRect(), b = cellEls[to].getBoundingClientRect();
    for (const [cell, x, y] of [[to, a.left - b.left, a.top - b.top], ...(swapped ? [[from, b.left - a.left, b.top - a.top]] : [])]) {
      const image = cellEls[cell].querySelector('img');
      if (!image) continue;
      animations.get(cell)?.cancel();
      const animation = image.animate([{ transform: `translate(${x}px,${y}px) scale(1.08)` }, { transform: 'translate(0,0) scale(1)' }], { duration: 210, easing: 'cubic-bezier(.2,.8,.2,1)' });
      animations.set(cell, animation);
      animation.onfinish = () => animations.delete(cell);
    }
  }
  function celebrate(text: string) {
    const notice = document.createElement('div'); notice.className = 'mm-notice';
    notice.textContent = text; $('mm').append(notice);
    setTimeout(() => notice.remove(), 2600);
  }
  function act(from: number, to: number, wasDragged = false) {
    const before = s.discovered.length, level = s.level;
    const r = move(s, from, to);
    selected = null;
    if (r === 'merged') {
      const it = s.cells[to]!;
      const fresh = s.discovered.length > before;
      status(`Merged into ${itemName(it)}!${fresh ? ' New discovery!' : ''}${it.tier === TOP_TIER ? ' The top of the chain!' : ''}`);
      playSound(s.level > level ? 'levelup' : fresh ? 'discover' : 'merge');
      if (fresh) celebrate(`Discovered: ${itemName(it)}`);
      if (s.level > level) celebrate(`Level ${s.level}! ${newChainNote(level)}`);
    } else if (r === 'swapped') { status('Swapped. Match two identical items to merge.'); playSound('place'); }
    else if (r === 'moved') { status('A new spot for a little wonder.'); playSound('place'); }
    else playSound('invalid');
    persist();
    render(r === 'merged' ? to : undefined);
    if (!wasDragged && (r === 'moved' || r === 'swapped')) animateMove(from, to, r === 'swapped');
  }

  function tap(i: number) {
    if (selected == null) {
      if (s.cells[i]) { playSound('tap'); selected = i; status(`${itemName(s.cells[i]!)} picked up — tap where it should go.`); }
    } else if (selected === i) {
      selected = null;
      status('Put back.');
    } else {
      act(selected, i);
      return;
    }
    paintBoard();
  }

  // Dragging: a ghost follows the pointer; a short press with no movement is a tap.
  let drag: { from: number; x: number; y: number; ghost: HTMLElement | null; id: number } | null = null;
  board.addEventListener('pointerdown', (e) => {
    const cell = (e.target as Element).closest<HTMLButtonElement>('.mm-cell');
    if (!cell || e.button !== 0) return;
    const i = Number(cell.dataset.i);
    if (!s.cells[i]) return;
    // No pointer capture yet: capturing now would send the tap's click to
    // the board instead of the square. It starts once a real drag begins.
    drag = { from: i, x: e.clientX, y: e.clientY, ghost: null, id: e.pointerId };
  });
  board.addEventListener('pointermove', (e) => {
    if (!drag || e.pointerId !== drag.id) return;
    if (!drag.ghost && Math.hypot(e.clientX - drag.x, e.clientY - drag.y) > 8) {
      drag.ghost = document.createElement('div');
      drag.ghost.className = 'mm-ghost';
      drag.ghost.innerHTML = itemMarkup(s.cells[drag.from]!);
      selected = drag.from; paintBoard();
      document.body.append(drag.ghost);
      cellEls[drag.from].classList.add('lifting');
      board.setPointerCapture(e.pointerId);
    }
    if (drag.ghost) {
      drag.ghost.style.left = `${e.clientX}px`; drag.ghost.style.top = `${e.clientY}px`;
      const under = document.elementFromPoint(e.clientX, e.clientY)?.closest<HTMLButtonElement>('.mm-cell');
      cellEls.forEach(cell => cell.classList.toggle('drop-target', cell === under));
    }
  });
  const endDrag = (e: PointerEvent) => {
    if (!drag || e.pointerId !== drag.id) return;
    const d = drag;
    drag = null;
    cellEls.forEach(cell => cell.classList.remove('drop-target'));
    if (board.hasPointerCapture(e.pointerId)) board.releasePointerCapture(e.pointerId);
    cellEls[d.from].classList.remove('lifting');
    if (!d.ghost) return; // a plain tap: the click handler deals with it
    d.ghost.remove();
    const under = document.elementFromPoint(e.clientX, e.clientY)?.closest<HTMLButtonElement>('.mm-cell');
    suppressClick = true;
    if (under && e.type !== 'pointercancel') act(d.from, Number(under.dataset.i), true);
    else { selected = null; paintBoard(); status('Item put back.'); }
    setTimeout(() => { suppressClick = false; }, 0);
  };
  let suppressClick = false;
  board.addEventListener('pointerup', endDrag);
  board.addEventListener('pointercancel', endDrag);
  board.addEventListener('click', (e) => {
    if (suppressClick) { suppressClick = false; return; }
    const cell = (e.target as Element).closest<HTMLButtonElement>('.mm-cell');
    if (cell) tap(Number(cell.dataset.i));
  });

  board.addEventListener('keydown', (e) => {
    const cell = (e.target as Element).closest<HTMLButtonElement>('.mm-cell');
    if (!cell) return;
    const i = Number(cell.dataset.i);
    const offsets: Record<string, number> = { ArrowLeft: -1, ArrowRight: 1, ArrowUp: -BOARD_W, ArrowDown: BOARD_W };
    if (e.key in offsets) { e.preventDefault(); cellEls[Math.max(0, Math.min(cellEls.length - 1, i + offsets[e.key]))].focus(); }
    if (e.key === 'Escape') { selected = null; paintBoard(); }
  });
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden || !drag) return;
    drag.ghost?.remove(); cellEls[drag.from].classList.remove('lifting');
    if (board.hasPointerCapture(drag.id)) board.releasePointerCapture(drag.id);
    drag = null; selected = null;
    cellEls.forEach(cell => cell.classList.remove('drop-target')); paintBoard();
  });

  /* ---------- orders ---------- */

  function paintOrders() {
    const box = $('mm-orders');
    box.textContent = '';
    for (const o of s.orders) {
      const ready = !!orderCells(s, o);
      const card = document.createElement('article');
      card.className = `mm-order${ready ? ' ready' : ''}`;
      card.innerHTML = `<div class="wants">${o.wants.map((w) => `<span class="want" title="${chains[w.chain].items[w.tier - 1].name}">${itemMarkup(w)}<small>${chains[w.chain].items[w.tier - 1].name}</small></span>`).join('')}</div>
        <p class="reward">${o.coins} coins · ${o.xp} XP</p>`;
      const go = document.createElement('button');
      go.type = 'button';
      go.className = 'btn';
      go.textContent = ready ? 'Deliver' : 'Not yet';
      go.disabled = !ready;
      go.addEventListener('click', () => {
        const level = s.level;
        const deliveryCells = orderCells(s, o);
        const flights = deliveryCells?.map(i => ({ item: s.cells[i]!, rect: cellEls[i].getBoundingClientRect() })) ?? [];
        const target = card.getBoundingClientRect();
        if (deliver(s, o.id)) {
          playSound(s.level > level ? 'levelup' : 'deliver');
          if (s.level > level) celebrate(`Level ${s.level}! ${newChainNote(level)}`);
          if (!reducedMotion()) flights.forEach(({ item, rect }) => {
            const flight = document.createElement('div'); flight.className = 'mm-flight'; flight.innerHTML = itemMarkup(item);
            flight.style.cssText = `left:${rect.left}px;top:${rect.top}px;width:${rect.width}px;height:${rect.height}px`;
            document.body.append(flight);
            const animation = flight.animate([{ transform: 'translate(0,0) scale(1)', opacity: 1 }, { transform: `translate(${target.left - rect.left + target.width / 2}px,${target.top - rect.top}px) scale(.3)`, opacity: 0 }], { duration: 500, easing: 'ease-in' });
            animation.onfinish = () => flight.remove();
          });
          status(`Order filled: +${o.coins} coins.${s.level > level ? ` Level ${s.level}! ${newChainNote(level)}` : ''}`);
          selected = null;
          persist();
          render();
        }
      });
      const swap = document.createElement('button');
      swap.type = 'button';
      swap.className = 'btn secondary mm-swap';
      swap.textContent = `Swap · ${SKIP_ORDER_COST} coins`;
      swap.disabled = s.coins < SKIP_ORDER_COST;
      swap.addEventListener('click', () => { if (skipOrder(s, o.id)) { playSound('place'); persist(); render(); status('New order.'); } });
      card.append(go, swap);
      box.append(card);
    }
  }

  function newChainNote(oldLevel: number) {
    const fresh = chainIds.filter((c) => chains[c].unlockLevel > oldLevel && chains[c].unlockLevel <= s.level);
    return fresh.length ? `The sketchbook can now draw ${fresh.map((c) => chains[c].name).join(' and ')}!` : '';
  }

  /* ---------- top bar, buttons, collection ---------- */

  function paintBar() {
    refillInk(s, Date.now());
    $('mm-level').textContent = String(s.level);
    $('mm-xp').style.width = `${(s.xp / xpToNext(s.level)) * 100}%`;
    $('mm-ink').textContent = `${s.ink}/${inkMax(s)}`;
    const wait = nextInkIn(s, Date.now());
    $('mm-ink-next').textContent = wait ? ` +1 in ${Math.floor(wait / 60)}:${String(wait % 60).padStart(2, '0')}` : '';
    $('mm-coins').textContent = String(s.coins);
    $<HTMLButtonElement>('mm-draw').disabled = s.ink < 1 || !s.cells.includes(null);
    $<HTMLButtonElement>('mm-buy').disabled = s.coins < INK_POT.cost;
  }

  function paintTools() {
    const perks = mergePerks(s);
    const focus = $<HTMLSelectElement>('mm-focus');
    focus.innerHTML = '<option value="">All unlocked chains</option>' + unlockedChains(s).map(chain => `<option value="${chain}">${chains[chain].name}</option>`).join('');
    focus.disabled = !perks.focus; focus.value = s.focus ?? '';
    $('mm-tools-help').textContent = `${perks.focus ? 'Choose a chain to draw, at the same one-ink cost.' : 'Chapter 5 unlocks focused drawing.'} Ink refills every ${perks.inkSeconds} seconds.`;
    $('mm-satchel-title').textContent = perks.satchel ? `Satchel · ${s.satchel?.length ?? 0} / ${perks.satchel} items` : 'Satchel · unlocks in chapter 6';
    $('mm-satchel').innerHTML = s.satchel?.length ? s.satchel.map((item, index) => `<button type="button" class="mm-pocket" data-retrieve="${index}" aria-label="Retrieve ${itemName(item)}"${s.cells.includes(null) ? '' : ' disabled'}>${itemMarkup(item)}<small>${itemName(item)} · ${item.tier}</small></button>`).join('') : '<p class="muted">A little extra space for the things you want to keep.</p>';
  }
  function render(flash?: number) { paintBar(); paintOrders(); paintBoard(flash); studio.render(); paintTools(); }
  $('mm-focus').addEventListener('change', () => {
    const value = $<HTMLSelectElement>('mm-focus').value as keyof typeof chains;
    if (!mergePerks(s).focus || (value && !unlockedChains(s).includes(value))) return;
    s.focus = value || undefined;
    persist(); playSound('tap'); render();
    status(value ? `Drawing ${chains[value].name}. Change focus whenever you like.` : 'Drawing from all unlocked chains.');
  });
  $('mm-store').addEventListener('click', () => {
    if (selected == null || !storeItem(s, selected)) return;
    selected = null; persist(); playSound('place'); render();
    $<HTMLDetailsElement>('mm-satchel-panel').open = true;
    status('Item tucked safely into your satchel.');
  });
  $('mm-satchel').addEventListener('click', event => {
    const button = (event.target as Element).closest<HTMLButtonElement>('[data-retrieve]');
    if (!button || button.disabled || !retrieveItem(s, Number(button.dataset.retrieve))) return;
    selected = null; persist(); playSound('place'); render(); status('Item returned to the board.');
  });

  $('mm-draw').addEventListener('click', () => {
    const cell = draw(s, Date.now());
    if (cell == null) {
      playSound('invalid');
      status(s.ink < 1 ? 'Out of ink — wait for a refill, buy a pot, or fill an order.' : 'The board is full. Merge something, or erase a doodle to make room.');
      return;
    }
    playSound('draw');
    status(`Drew a ${itemName(s.cells[cell]!)}.`);
    persist();
    render(cell);
  });
  $('mm-erase').addEventListener('click', () => {
    if (selected == null || !s.cells[selected]) return;
    const name = itemName(s.cells[selected]!);
    const coins = erase(s, selected);
    playSound('erase');
    selected = null;
    status(`Erased the ${name} for ${coins} coin${coins === 1 ? '' : 's'}.`);
    persist();
    render();
  });
  $('mm-buy').addEventListener('click', () => {
    if (buyInk(s, Date.now())) { playSound('draw'); status(`+${INK_POT.ink} ink.`); persist(); render(); }
  });
  $('mm-book').addEventListener('click', () => {
    playSound('tap');
    const body = $('mm-collection-body');
    const unlocked = unlockedChains(s);
    body.innerHTML = `<p class="muted">${s.discovered.length} of ${chainIds.length * TOP_TIER} doodles discovered.</p>` + chainIds.map((c) => {
      const ch = chains[c];
      const open = unlocked.includes(c);
      return `<h3>${ch.name}${open ? '' : ` <small>· unlocks at level ${ch.unlockLevel}</small>`}</h3><ol class="mm-book">${ch.items.map((it, k) =>
        s.discovered.includes(`${c}:${k + 1}`)
          ? `<li>${itemMarkup({ chain: c, tier: k + 1 })}<small>${it.name}</small></li>`
          : `<li class="unknown"><span aria-hidden="true">?</span><small>Level ${k + 1}</small></li>`).join('')}</ol>`;
    }).join('');
    $<HTMLDialogElement>('mm-collection').showModal();
  });

  const clock = setInterval(paintBar, 1000);
  window.addEventListener('pagehide', () => { persist(); clearInterval(clock); });
  render();
  persist(); // Persist the additive story migration without resetting old play.
</script>

<!-- Global: the board, orders and collection are built by the script. Every
     selector is prefixed mm-. -->
<style is:global>
  .mm { position:relative; max-width:840px; margin:auto; }
  .mm-orders-label { display:flex; justify-content:space-between; gap:10px; max-width:660px; margin:0 auto 10px; font-size:12px; font-weight:800; }
  .mm-orders-label span { font-size:10px; font-weight:500; color:var(--ink-soft); text-align:right; }
  .mm-tools { max-width:660px; margin:0 auto 22px; padding:15px 18px; background:var(--paper); border:1px solid var(--rule); border-radius:18px; }
  .mm-tools label { display:flex; align-items:center; justify-content:space-between; gap:12px; font-size:12px; font-weight:800; }
  .mm-tools select { min-width:0; max-width:65%; font-size:12px; }
  .mm-tools p { font-size:10px; margin:8px 0 0; }
  .mm-tools summary { font-size:12px; cursor:pointer; padding-top:10px; }
  .mm-satchel { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:8px; margin-top:12px; }
  .mm-satchel>p { grid-column:1/-1; }
