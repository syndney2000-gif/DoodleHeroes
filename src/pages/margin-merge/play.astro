  .mm-board { display:grid; grid-template-columns:repeat(var(--w),minmax(0,1fr)); gap:7px; max-width:490px; margin:0 auto; padding:12px; background:#E6EBDD; border:1px solid #D8E0CE; border-radius:26px; touch-action:none; user-select:none; -webkit-user-select:none; }
  .mm-cell { position:relative; aspect-ratio:1; min-width:0; display:grid; place-items:center; padding:3px; background:#F3F5EC; border:1px solid #DCE3D3; border-radius:14px; color:var(--ink); }
  .mm-cell[data-chain] { background:var(--paper); box-shadow:0 3px 5px #304C3B0A; }
  .mm-cell[data-chain=heroes] { background:#F0E8ED; }
  .mm-cell[data-chain=paper] { background:#F8F0D9; }
