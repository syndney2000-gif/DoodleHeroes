  .mm-notice+.mm-notice { top:160px; }
  @keyframes mm-notice { from { opacity:0; margin-top:-10px; } }
  .mm-help { max-width:660px; margin:36px auto; }
  @media(max-width:480px) { .mm-orders { gap:8px; } .mm-order { padding:10px 7px; border-radius:18px; } .mm-order .want small { display:none; } .mm-order .merge-art { width:38px; height:38px; } .mm-board { gap:5px; padding:8px; border-radius:20px; } .mm-cell { border-radius:10px; } .mm-pill { gap:4px; font-size:11px; padding:6px 8px; } .mm-bar { gap:7px; } .mm-pill small { font-size:8px; } .mm-actions .btn { flex:1 1 40%; padding:10px; } .mm-draw { min-width:0; } .mm-book { gap:6px; } .mm-book li { padding:6px; } }
</style>

