---
import Base from '../layouts/Base.astro';
import StreakStrip from '../components/StreakStrip.astro';
import { stickers } from '../lib/achievements';
import Icon from '../components/Icon.astro';
---
<Base
  title="Your journal"
  description="See which Doodle Heroes puzzles you've solved and reset your saved progress."
  ads={false}
  noindex
  section="journal"
>
  <p class="eyebrow">Your little journal</p>
  <h1>Look how far you’ve wandered.</h1>
  <p class="lede">Progress is saved only in this browser, on this device. Nothing is sent to us, and clearing your browser’s site data removes it too.</p>

  <StreakStrip />

  <div class="album-head"><h2>Sticker album</h2><span class="album-count" data-album-count></span></div>
  <ul class="stickers">
    {stickers.map((x) => (
      <li data-sticker={x.id}>
        <span class={`badge big ${x.tint}`}><Icon name={x.icon} size={30} /></span>
        <span class="name">{x.name}</span>
        <span class="how">{x.how}</span>
      </li>
    ))}
  </ul>

  <div id="summary"><p class="muted">Loading…</p></div>

  <h2>Start over</h2>
  <p>Reset clears everything saved on this device — puzzle boards, stars and best times, Merge discoveries and orders, Doodle Guess history, the expedition, and Scribble Siege coins, upgrades, records and your drawn hero. Your sound and motion preferences stay. It can’t be undone.</p>
  <p><button class="btn secondary" type="button" id="reset">Reset all progress</button></p>
  <p id="reset-status" role="status" aria-live="polite"></p>
</Base>

<script>
  import { clearAll, results, load, keys, save } from '../lib/storage';
  import { formatTime, starText } from '../lib/scoring';
  import { allPuzzles as sketches } from '../games/nonogram/puzzles';
  import { allPuzzles as maps } from '../games/bridges/puzzles';
  import { allPuzzles as grids } from '../games/net/puzzles';
  import { expedition } from '../content/expedition';
  import { earnedIds } from '../lib/achievements';
  import { loadProfile } from '../games/survivor/meta';
  import type { MergeState } from '../games/merge/engine';
  import { studioChapters, studioStatus } from '../games/merge/studio';
  import { dailyDrawing, isRight, MAX_GUESSES } from '../games/doodle-guess/game';
  import { playSound } from '../lib/audio';
  import { decorations, lightBalance, lightEarned, owned } from '../lib/lantern';
  import { readSnapshot } from '../lib/world';

  const games = [
    { key: 'island-sketch', name: 'Island Sketch', noun: 'sketches', puzzles: sketches },
    { key: 'isle-spans', name: 'Isle Spans', noun: 'maps', puzzles: maps },
    { key: 'lighthouse-wiring', name: 'Lighthouse Wiring', noun: 'grids', puzzles: grids },
  ];

  const el = (tag: string, text?: string) => {
    const node = document.createElement(tag);
    if (text != null) node.textContent = text;
    return node;
  };

  function render() {
    const done = results();
    const root = document.getElementById('summary')!;
    root.textContent = '';

    const merge = load<MergeState>('margin-merge:state');
    const cards = el('div'); cards.className = 'record-grid';
    function record(title: string, number: string, detail: string, href: string) {
      const card = el('section'); card.className = 'card';
      const count = el('p', number); count.className = 'record-number';
      const link = el('a', 'Keep exploring →'); link.href = href;
      card.append(el('h3', title), count, el('p', detail), link); cards.append(card);
    }
    const studio = merge ? studioStatus(merge) : null;
    record('Margin Merge', `${studio?.progress.restored ?? 0} / ${studioChapters.length}`, `${studio?.complete ? 'Island stories complete' : studio?.act.title ?? 'Island projects'}${(studio?.progress.restored ?? 0) >= 4 ? ' · Studio restored' : ''} · ${merge?.discovered?.length ?? 0} of 32 discoveries · Level ${merge?.level ?? 1}`, '/margin-merge/play');
    const guessDays = keys().filter(k => k.startsWith('doodle-guess:day:')).flatMap(k => {
      const guesses = load<string[]>(k);
      if (!Array.isArray(guesses)) return [];
      const drawing = dailyDrawing(k.slice('doodle-guess:day:'.length));
      const solved = guesses.some(g => isRight(drawing, g));
      return solved || guesses.length >= MAX_GUESSES ? [{ solved }] : [];
    });
    record('Doodle Guess', String(guessDays.filter(day => day.solved).length), `${guessDays.length} daily doodles played · ${guessDays.filter(day => day.solved).length} discovered`, '/doodle-guess/play');
    const siege = loadProfile();
    record('Lantern light', String(lightBalance(readSnapshot())), `${lightEarned(readSnapshot())} earned in all · ${owned().length} of ${decorations.length} decorations on the island`, '/');
    record('Scribble Siege', String(siege.wins), `${siege.runs} adventures · ${siege.totalKills.toLocaleString()} scribbles defeated`, '/scribble-siege/play');
    root.append(cards);
    const longest = Math.max(0, ...Object.values(siege.bestTime).map((t) => t ?? 0));
    root.append(
      el('h2', 'Scribble Siege'),
      el('p', siege.runs
        ? `${siege.runs} runs · ${siege.wins} sieges survived · longest run ${formatTime(longest)} · ${siege.totalKills.toLocaleString()} scribbles defeated · ${siege.coins} coins in the bank`
        : 'No runs yet.'),
    );

    const chaptersDone = expedition.filter((c) => c.tasks.every((t) => done[`${t.game}/${t.puzzleId}`])).length;
    root.append(el('h2', 'Lantern Isles expedition'), el('p', `${chaptersDone} of ${expedition.length} chapters complete.`));

    for (const game of games) {
      const solved = game.puzzles.filter((p) => done[`${game.key}/${p.id}`]);
      const stars = solved.reduce((n, p) => n + done[`${game.key}/${p.id}`].stars, 0);
      root.append(el('h2', game.name), el('p', `${solved.length} of ${game.puzzles.length} ${game.noun} solved · ${stars} of ${game.puzzles.length * 3} stars`));
      if (!solved.length) continue;
      const table = el('table');
      const head = el('thead');
      const hr = el('tr');
      for (const h of ['Puzzle', 'Stars', 'Best time']) hr.append(el('th', h));
      head.append(hr);
      const body = el('tbody');
      for (const p of solved) {
        const r = done[`${game.key}/${p.id}`];
        const row = el('tr');
        row.append(el('td', p.title), el('td', starText(r.stars)), el('td', formatTime(r.seconds)));
        body.append(row);
      }
      table.append(head, body);
      root.append(table);
    }
  }

  function renderStickers() {
    const earned = earnedIds(results());
    // Stickers earned since the album was last opened peel on with a flourish.
    const seen = new Set(load<string[]>('stickers:seen') ?? []);
    document.querySelector('[data-album-count]')!.textContent = `${earned.size} of ${document.querySelectorAll('[data-sticker]').length} collected`;
    for (const li of document.querySelectorAll<HTMLElement>('[data-sticker]')) {
      const on = earned.has(li.dataset.sticker!);
      li.classList.toggle('earned', on);
      li.classList.toggle('new', on && !seen.has(li.dataset.sticker!));
      li.setAttribute('aria-label', `${li.querySelector('.name')!.textContent}: ${on ? 'earned' : 'not yet earned'}`);
    }
  }

  render();
  renderStickers();
  save('stickers:seen', [...earnedIds(results())]);
  document.getElementById('reset')!.addEventListener('click', () => {
    if (!confirm('Reset all saved progress on this device?')) return;
    const retained = keys().filter(k => k.startsWith('settings:')).map(k => [k, load<unknown>(k)] as const);
    clearAll();
    retained.forEach(([k, v]) => { if (v !== undefined) save(k, v); });
    playSound('erase');
    render();
    renderStickers();
    document.getElementById('reset-status')!.textContent = 'All progress cleared.';
  });
</script>

<style>
  .stickers{ list-style:none; padding:0; display:grid; gap:14px; grid-template-columns:repeat(auto-fill,minmax(150px,1fr)); margin:12px 0 24px; }
  .stickers li{
    margin:0; display:flex; flex-direction:column; align-items:center; text-align:center; gap:2px;
    padding:12px 8px; border:2px dashed var(--rule); border-radius:var(--wobble-soft); background:var(--paper);
  }
  .stickers .badge{ filter:grayscale(1); opacity:.3; }
  .stickers .name{ font-family:var(--hand); font-size:20px; color:var(--ink-soft); }
  .stickers .how{ font-size:13px; color:var(--ink-soft); }
  /* Earned stickers peel off the sheet: solid border, colour, a slight tilt. */
  .stickers li.earned{ border:2px solid var(--ink); box-shadow:2px 3px 0 var(--shadow);  background:#FFF8D9; }
  .stickers li.earned:nth-child(even){  }
  .stickers li.earned .badge{ filter:none; opacity:1; }
  .stickers li.earned .name{ color:var(--ink); }
  .stickers li.earned:nth-child(3n+1){ transform:rotate(-1.5deg); } .stickers li.earned:nth-child(3n+2){ transform:rotate(1deg); }
  .stickers li.new{ animation:album-peel .8s var(--ease-bounce) both; position:relative; }
  .stickers li.new::after{ content:'New!'; position:absolute; top:-10px; right:-6px; padding:2px 8px; border-radius:999px; background:var(--red); color:#fff; font:700 12px var(--hand); transform:rotate(8deg); }
  @keyframes album-peel{ from{ transform:rotate(-14deg) scale(.6); opacity:0; } }
  .album-head{ display:flex; align-items:baseline; justify-content:space-between; gap:12px; }
  .album-count{ font-weight:900; color:var(--ink-soft); }
</style>
