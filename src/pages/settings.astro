---
import Base from '../layouts/Base.astro';
---
<Base title="Settings" description="Make your Doodle Heroes experience feel just right." section="settings" ads={false} noindex>
  <p class="eyebrow">Make yourself at home</p>
  <h1>A little more you.</h1>
  <p class="lede">A few small comforts for your time on the island.</p>
  <section class="card" aria-label="Preferences">
    <label class="setting-row" for="setting-sound"><span><strong>Sound effects</strong><p>Soft taps, little discoveries, and a reason to celebrate.</p></span><input type="checkbox" id="setting-sound" /></label>
    <label class="setting-row" for="setting-volume"><span><strong>Effects volume</strong><p>Find your comfortable level.</p></span><input type="range" id="setting-volume" min="0" max="100" step="5" /></label>
    <label class="setting-row" for="setting-music"><span><strong>Meadow music</strong><p>A playful island stroll: plucked strings, soft whistles and a gentle rhythm. Off until you invite it in.</p></span><input type="checkbox" id="setting-music" /></label>
    <label class="setting-row" for="setting-music-volume"><span><strong>Music volume</strong><p>Keep the melody as soft as you like.</p></span><input type="range" id="setting-music-volume" min="0" max="100" step="5" /></label>
    <label class="setting-row" for="setting-motion"><span><strong>Reduce motion</strong><p>Keep things still. Your device’s preference is always respected.</p></span><input type="checkbox" id="setting-motion" /></label>
    <label class="setting-row" for="setting-theme"><span><strong>Theme</strong><p>Daylight, or a lantern-lit night with the boards glowing like paper.</p></span><select id="setting-theme"><option value="day">Daylight</option><option value="night">Night</option><option value="auto">Match my device</option></select></label>
    <label class="setting-row" for="setting-haptics"><span><strong>Vibration</strong><p>A gentle buzz when you finish a line or a puzzle, on phones that support it.</p></span><input type="checkbox" id="setting-haptics" /></label>
    <p id="settings-status" role="status" aria-live="polite" style="margin-top:18px;margin-bottom:0"></p>
  </section>
  <section class="card"><h2>Your progress belongs to you.</h2><p>Games save in this browser. You can review your discoveries and reset your progress in the Journal.</p><a class="btn secondary" href="/progress">Open your journal →</a></section>
  <p class="muted">The music and cartoon sound effects are original, synthesized and free to reuse under CC0. <a href="/audio/README.md">Audio source and dedication</a>.</p>
</Base>
<script>
  import { musicOn, musicVolume, playSound, setMusic, setMusicVolume, setSound, setVolume, soundOn, soundVolume } from '../lib/audio';
  import { load, save } from '../lib/storage';
  import { syncMotion } from '../lib/site-shell';
  import { buzz, hapticsOn } from '../lib/juice';
  const sound = document.getElementById('setting-sound') as HTMLInputElement;
  const volume = document.getElementById('setting-volume') as HTMLInputElement;
  const motion = document.getElementById('setting-motion') as HTMLInputElement;
  const music = document.getElementById('setting-music') as HTMLInputElement;
  const musicLevel = document.getElementById('setting-music-volume') as HTMLInputElement;
  const haptics = document.getElementById('setting-haptics') as HTMLInputElement;
  const status = document.getElementById('settings-status')!;
  haptics.checked = hapticsOn();
  const theme = document.getElementById('setting-theme') as HTMLSelectElement;
  theme.value = load<string>('settings:theme') ?? 'day';
  theme.addEventListener('change', () => {
    save('settings:theme', theme.value);
    const night = theme.value === 'night' || (theme.value === 'auto' && matchMedia('(prefers-color-scheme: dark)').matches);
    document.documentElement.toggleAttribute('data-theme', night);
    if (night) document.documentElement.dataset.theme = 'night';
    document.querySelector<HTMLMetaElement>('meta[name=theme-color]')!.content = night ? '#13222A' : '#FAF7EF';
    status.textContent = `Theme set to ${theme.selectedOptions[0].text.toLowerCase()}.`;
  });
  haptics.addEventListener('change', () => { save('settings:haptics', haptics.checked); buzz(30); status.textContent = haptics.checked ? 'Vibration enabled.' : 'Vibration off.'; });
  sound.checked = soundOn(); volume.value = String(soundVolume() * 100);
  music.checked = musicOn(); musicLevel.value = String(musicVolume() * 100);
  motion.checked = !!load<boolean>('settings:reduced-motion');
  sound.addEventListener('change', () => { setSound(sound.checked); playSound('tap'); status.textContent = sound.checked ? 'Sound effects enabled.' : 'Sound effects muted.'; });
  window.addEventListener('dh:audio-change', () => { sound.checked = soundOn(); music.checked = musicOn(); });
  music.addEventListener('change', () => { setMusic(music.checked); status.textContent = music.checked ? 'Meadow music enabled.' : 'Music muted.'; });
  musicLevel.addEventListener('input', () => setMusicVolume(Number(musicLevel.value) / 100));
  musicLevel.addEventListener('change', () => { status.textContent = `Music volume set to ${musicLevel.value}%.`; });
  volume.addEventListener('input', () => setVolume(Number(volume.value) / 100));
  volume.addEventListener('change', () => { playSound('merge'); status.textContent = `Volume set to ${volume.value}%.`; });
  motion.addEventListener('change', () => { save('settings:reduced-motion', motion.checked); syncMotion(); status.textContent = motion.checked ? 'Reduced motion enabled.' : 'Using your device’s motion preference.'; });
</script>
